{
  "name": "ai-web-system",
  "version": "0.1.0",
  "description": "AI Web 协作体系工作区 - 标准本体、任务入口、执行协议、角色边界与多 Agent 协作协议",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ai-front-workbench dev",
    "build": "pnpm --filter ai-front-workbench build",
    "check": "pnpm --filter ai-front-workbench check",
    "verify-encoding": "node scripts/verify-encoding.mjs .",
    "check-paths": "node scripts/check-absolute-paths.mjs .",
    "sync-rules": "node scripts/sync-rules-to-cursor.mjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
