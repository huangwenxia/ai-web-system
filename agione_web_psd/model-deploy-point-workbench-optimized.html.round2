            </div>
            <div v-if="$slots.actions" class="header-box__right">
              <slot name="actions"></slot>
            </div>
          </div>
          <div v-if="tabs.length" class="header-box__content" style="padding-top:0;border-top:none;">
            <div class="detail-tabs" data-component="detail-tabs">
              <button
                v-for="tab in tabs" :key="tab.value"
                class="detail-tabs__item"
                :class="{ 'is-active': activeTab === tab.value }"
                type="button"
                @click="$emit('update:activeTab', tab.value)"
              >{{ tab.label }}</button>
            </div>
          </div>
        </div>
        <el-scrollbar>
          <div class="scroll-box-inner" data-scroll-box data-component="scroll-box">
            <slot></slot>
          </div>
        </el-scrollbar>
      </div>
    `
  },

