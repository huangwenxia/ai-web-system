/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 KpiCard 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.kpi-card {
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-xl);
  padding: var(--ui-space-lg);
  display: flex; flex-direction: column; gap: var(--ui-space-sm);
  min-width: 0;
}
.kpi-card__header { display: flex; justify-content: space-between; align-items: center; }
.kpi-card__title {
  font-size: 12px; font-weight: 500;
  color: var(--ui-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.kpi-card__icon { width: var(--ui-icon-lg); height: var(--ui-icon-lg); }
.kpi-card__icon--primary     { color: var(--ui-color-primary); }
.kpi-card__icon--success     { color: var(--ui-color-success); }
.kpi-card__icon--warning     { color: var(--ui-color-warning); }
.kpi-card__icon--destructive { color: var(--ui-color-destructive); }
.kpi-card__value {
  /* v5.1: 闁稿﹤銈搁弫鎾诲棘閵堝棗顏� .type-kpi 濞戞挴鍋撻梺璺ㄥ枛閹筋亪鏁愯箛鏂款伓28/700/mono/tabular-nums闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕悹鍥ㄦ崌閺佹捇寮妶鍡楊伓闂侊拷?hook闂佽法鍠愰弸濠氬箯缁屾溂rgin / color闂佽法鍠愰弸濠氬箯?/
  font-family: var(--ui-font-mono);
  font-size: 28px; font-weight: 700; line-height: 1.2;
  color: var(--ui-text-primary);
  font-variant-numeric: tabular-nums;
}
.kpi-card__trend {
  font-size: 12px;
  display: flex; align-items: center; gap: 4px;
}
.kpi-card__trend--up      { color: var(--ui-color-success); }
.kpi-card__trend--down    { color: var(--ui-color-destructive); }
.kpi-card__trend--neutral { color: var(--ui-text-muted); }
.kpi-card__trend [data-lucide] { width: 14px; height: 14px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 StatusBadge 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.status-badge {
  display: inline-flex; align-items: center; gap: 6px;
  height: 22px; padding: 3px 10px;
  border-radius: var(--ui-radius-pill);
  font-size: 11px; font-weight: 500; letter-spacing: 0.2px;
}
.status-badge__dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: currentColor; flex-shrink: 0;
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 EmptyState 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: var(--ui-space-3xl) var(--ui-space-xl);
  gap: var(--ui-space-md);
  text-align: center;
}
.empty-state__icon {
  width: var(--ui-icon-2xl); height: var(--ui-icon-2xl);
  color: var(--ui-text-muted);
}
.empty-state__title { font-size: 16px; font-weight: 600; color: var(--ui-text-primary); }
.empty-state__hint  { font-size: 13px; color: var(--ui-text-muted); max-width: 320px; line-height: 1.6; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Alert (Inline) 闂佽法鍠愰弸濠氬箯?.14 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.alert {
  display: flex; align-items: flex-start; gap: var(--ui-space-sm);
  padding: var(--ui-space-md) var(--ui-space-base);
  border-radius: var(--ui-radius-lg);
  border-left: 4px solid;
  font-size: 14px;
}
.alert-icon { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
.alert-body { flex: 1; min-width: 0; }
.alert-title { font-weight: 500; line-height: 1.5; }
.alert-desc  { font-size: 13px; color: var(--ui-text-muted); margin-top: 2px; line-height: 1.5; }
.alert-close { margin-left: auto; color: var(--ui-text-muted); padding: 2px; line-height: 0; }
.alert-close:hover { color: var(--ui-text-primary); }
.alert-close [data-lucide] { width: 14px; height: 14px; }
.alert-success  { background: var(--ui-color-success-subtle);     border-color: var(--ui-color-success);     color: var(--ui-color-success); }
.alert-warning  { background: var(--ui-color-warning-subtle);     border-color: var(--ui-color-warning);     color: var(--ui-color-warning); }
.alert-error    { background: var(--ui-color-destructive-subtle); border-color: var(--ui-color-destructive); color: var(--ui-color-destructive); }
.alert-info     { background: var(--ui-color-primary-subtle);     border-color: var(--ui-color-primary);     color: var(--ui-color-primary); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 UsageBar (v3.5) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.usage-bar { display: inline-flex; align-items: center; gap: var(--ui-space-sm); min-width: 120px; }
.usage-bar__track {
  flex: 1; height: 6px;
  background: var(--ui-bg-muted);
  border-radius: var(--ui-radius-pill);
  overflow: hidden;
  min-width: 60px;
}
.usage-bar__fill {
  height: 100%;
  border-radius: var(--ui-radius-pill);
  transition: width var(--ui-duration-base);
}
.usage-bar__fill--primary { background: var(--ui-color-primary); }
.usage-bar__fill--success { background: var(--ui-color-success); }
.usage-bar__fill--warning { background: var(--ui-color-warning); }
.usage-bar__fill--danger  { background: var(--ui-color-destructive); }
.usage-bar__text {
  font-family: var(--ui-font-mono);
  font-size: 11px;
  color: var(--ui-text-muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 KvCard (v3.5) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.kv-card {
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-lg);
  transition: border-color var(--ui-duration-fast);
}
.kv-card--hover:hover { border-color: var(--ui-color-primary); }
.kv-card__head {
  padding: var(--ui-space-md) var(--ui-space-base);
  border-bottom: 1px solid var(--ui-border-soft);
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--ui-space-sm);
}
.kv-card__title { font-size: 14px; font-weight: 600; color: var(--ui-text-primary); }
.kv-card__head-right { display: flex; align-items: center; gap: var(--ui-space-sm); }
.kv-card__body {
  padding: var(--ui-space-md) var(--ui-space-base);
  display: flex; flex-direction: column; gap: var(--ui-space-xs);
}
.kv-card__row {
  display: flex; align-items: flex-start; gap: var(--ui-space-sm);
  font-size: 13px; line-height: 1.6;
}
.kv-card__label { color: var(--ui-text-muted); flex-shrink: 0; }
.kv-card__value { flex: 1; min-width: 0; color: var(--ui-text-primary); word-break: break-word; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 DetailSection (v3.5) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.detail-section { display: flex; flex-direction: column; gap: var(--ui-space-md); }
.detail-section__head {
  display: flex; justify-content: space-between; align-items: center;
  padding-left: 12px;
  border-left: 4px solid var(--ui-color-primary);
  min-height: 20px;
}
.detail-section__title {
  font-size: 16px; font-weight: 600; color: var(--ui-text-primary);
  line-height: 1.25;
}
.detail-section__right { display: flex; align-items: center; gap: var(--ui-space-sm); }
.detail-section__body { padding-left: 16px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 TableActions (v3.5) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.table-actions { display: inline-flex; align-items: center; gap: 2px; }
.table-actions .el-button + .el-button { margin-left: 0; }
.el-dropdown-menu__item.is-danger { color: var(--ui-color-destructive); }
.el-dropdown-menu__item.is-danger:hover {
  background: var(--ui-color-destructive-subtle);
  color: var(--ui-color-destructive);
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 DetailPage 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁梻鍐啇缂嶅洭骞忕粚濡昻-back + detail-tabs闂佽法鍠愰弸濠氬箯?v3.5) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.btn-back {
  width: 32px; height: 32px;
  border-radius: var(--ui-radius-md);
  display: flex; align-items: center; justify-content: center;
  color: var(--ui-text-muted);
  transition: background var(--ui-duration-fast), color var(--ui-duration-fast);
  flex-shrink: 0;
}
.btn-back:hover { background: var(--ui-accent); color: var(--ui-text-primary); }
.btn-back [data-lucide] { width: 18px; height: 18px; }

.detail-tabs {
  display: flex; gap: var(--ui-space-base);
  border-bottom: 1px solid var(--ui-border-default);
}
.detail-tabs__item {
  padding: 8px 0;
  font-size: 14px; font-weight: 500;
  color: var(--ui-text-muted);
  border-bottom: 2px solid transparent;
  transition: color var(--ui-duration-fast), border-color var(--ui-duration-fast);
  margin-bottom: -1px;
  background: none; cursor: pointer;
}
.detail-tabs__item:hover { color: var(--ui-text-primary); }
.detail-tabs__item.is-active {
  color: var(--ui-color-primary);
  border-bottom-color: var(--ui-color-primary);
  font-weight: 600;
}

