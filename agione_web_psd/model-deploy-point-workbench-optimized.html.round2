  BalanceBox: {
    props: {
      info: { type: Object, required: true },
      lang: { type: String, default: 'en' },
    },
    computed: {
      level() {
        const lv = (this.info?.level || 'normal').toLowerCase();
        return ['normal', 'low', 'critical', 'empty'].includes(lv) ? lv : 'normal';
      },
      iconName() {
        return {
          normal:   'database',         // 闁革箑妫涢悺锟� + 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁悷娆愬釜缂嶅洭骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊宕箛娑欐櫢?EP Coin
          low:      'wallet',
          critical: 'triangle-alert',
          empty:    'circle-x',
        }[this.level];
      },
      showDot() { return this.level === 'critical' || this.level === 'empty'; },
      showTopUp() { return this.info?.showTopUp !== false; },
      currency() { return this.info?.currency || 'Credits'; },
      topUpText() {
        if (this.info?.topUpLabel) return this.info.topUpLabel;
        return this.lang === 'zh' ? '闂佽法鍠愰弸濠氬箯瀹勬壋鍋�? : 'Top Up';
      },
      formattedBalance() {
        const n = Number(this.info?.balance);
        if (!Number.isFinite(n)) return '--';
        return n.toLocaleString('en-US', { maximumFractionDigits: Number.isInteger(n) ? 0 : 2 });
      },
    },
    template: `
      <div class="balance-pill" data-component="balance-pill"
           :class="['balance-pill--' + level, { 'balance-pill--readonly': !showTopUp }]"
           role="status">
        <span v-if="showDot" class="balance-pill__dot" aria-hidden="true"></span>
        <i :data-lucide="iconName" class="balance-pill__icon"></i>
        <span class="balance-pill__num">{{ formattedBalance }}</span>
        <span class="balance-pill__unit">{{ currency }}</span>
        <button v-if="showTopUp" class="balance-pill__cta" type="button" @click.stop>
          <i data-lucide="plus"></i>
          <span>{{ topUpText }}</span>
        </button>
      </div>
    `
  },

