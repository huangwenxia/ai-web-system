.page-header {
  padding: 24px 28px 16px;
  /* v6.6: 闂佽法鍠撶€氭稓绮电憴鍕伓 border-bottom (闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鐑橀獎闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺锟�? */
  display: flex;
  justify-content: space-between;
  align-items: flex-end;            /* ? 闂佽法鍠愰弸濠氬箯?baseline 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 actions闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?flex-start */
  gap: 20px;
}
.page-header__left { min-width: 0; flex: 1; }
.page-header__eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600;
  color: var(--ui-text-muted);       /* ? 闂佽法鍠愰弸濠氬箯?muted 闂佽法鍠愰弸濠氬箯?primary */
  text-transform: uppercase;
  letter-spacing: 0.6px;
  margin-bottom: 6px;
}
.page-header__eyebrow [data-lucide] { width: 12px; height: 12px; }
.page-header__eyebrow-dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--ui-text-muted);
}
.page-header__title-row {
  display: inline-flex; align-items: center; gap: 12px;
}
.page-header__title {
  font-family: var(--ui-font-heading);
  font-size: 22px;                   /* ? 闂佽法鍠愰弸濠氬箯?22 闂佽法鍠愰弸濠氬箯?type scale 闂佽法鍠愰弸濠氬箯?3 闂佽法鍠愰弸濠氬箯閾氬倻绉� */
  font-weight: 700;                  /* ? 闂佽法鍠愰弸濠氬箯?700 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 800 */
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--ui-text-primary);
  margin: 0;
}
.page-header__subtitle {
  font-size: 13px; font-weight: 400;
  color: var(--ui-text-muted);
  margin: 6px 0 0;
  line-height: 1.55;                 /* ? 闂佽法鍠愰弸濠氬箯?1.55 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 1.4闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 2 闂佽法鍠愰弸濠氬箯閾氬倻鐟归梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞�?*/
}
.page-header__right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.page-header__status-pill {
  display: inline-flex; align-items: center;
  padding: 3px 10px;
  border-radius: var(--ui-radius-pill);
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.2px;
}
.page-header__status-pill--green  { background: var(--ui-color-success-subtle);     color: var(--ui-color-success); }
.page-header__status-pill--orange { background: var(--ui-color-warning-subtle);     color: var(--ui-color-warning); }
.page-header__status-pill--red    { background: var(--ui-color-destructive-subtle); color: var(--ui-color-destructive); }
.page-header__status-pill--purple { background: var(--ui-badge-purple-bg);          color: var(--ui-badge-purple-fg); }
.page-header__status-pill--muted  { background: var(--ui-badge-muted-bg);           color: var(--ui-badge-muted-fg); }
.page-header__back {
  padding: 14px 28px 0;
  font-size: 12px;
  color: var(--ui-text-muted);
  text-decoration: none;
  display: inline-flex; align-items: center; gap: 4px;
  transition: color var(--ui-duration-fast);
}
.page-header__back:hover { color: var(--ui-text-primary); }
.page-header__back [data-lucide] { width: 14px; height: 14px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 MetricsStrip (v3.8) 闂佽法鍠愰弸濠氬箯?闂佽法鍠栭妶娲礄閵堝棗顏堕柟绋挎喘閺佹捇寮妶鍡楊伓闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氱ero 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷/Overview 闂佽法鍠撻悡顐︽晲韫囨柨顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氾拷 */
.metrics-strip {
  display: grid;
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-lg);
  overflow: hidden;
}
.metrics-strip__cell {
  padding: var(--ui-space-base) var(--ui-space-lg);
  display: flex; flex-direction: column; gap: var(--ui-space-xs);
  min-width: 0;
}
.metrics-strip--divided .metrics-strip__cell + .metrics-strip__cell {
  border-left: 1px solid var(--ui-border-soft);
}
.metrics-strip__label {
  font-size: 11px; font-weight: 500;
  color: var(--ui-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.metrics-strip__value {
  font-family: var(--ui-font-mono);
  font-size: 22px; font-weight: 700;
  color: var(--ui-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  word-break: break-word;
}
.metrics-strip__value--accent { color: var(--ui-color-primary); }
.metrics-strip__sub { font-size: 12px; color: var(--ui-text-muted); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 HeroBand (v3.8) 闂佽法鍠愰弸濠氬箯?Overview 闁解偓閵夆晜鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞�?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.hero-band {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ui-space-2xl);
  padding: var(--ui-space-2xl);
  border-radius: var(--ui-radius-xl);
  border: 1px solid var(--ui-border-default);
}
.hero-band--primary { background: var(--ui-color-primary-subtle); }
.hero-band--neutral { background: var(--ui-bg-card); }
.hero-band--gradient {
  background: linear-gradient(135deg, var(--ui-color-primary-subtle) 0%, var(--ui-bg-card) 100%);
}
@media (min-width: 1024px) {
  .hero-band--with-right { grid-template-columns: 1fr 1fr; align-items: center; }
}
.hero-band__left { min-width: 0; }
.hero-band__eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 10px;
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-pill);
  font-size: 11px; font-weight: 600;
  color: var(--ui-color-primary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.hero-band__eyebrow [data-lucide] { width: 12px; height: 12px; }
.hero-band__title {
  font-family: var(--ui-font-heading);
  font-size: 28px; font-weight: 800; line-height: 1.2;
  color: var(--ui-text-primary);
  margin-top: 12px;
}
.hero-band__desc {
  font-size: 14px; color: var(--ui-text-muted); line-height: 1.6;
  margin-top: 8px;
}
.hero-band__points {
  display: flex; flex-direction: column; gap: 8px;
  margin-top: 16px;
}
.hero-band__point {
  display: flex; align-items: flex-start; gap: 8px;
  font-size: 13px; line-height: 1.5;
}
.hero-band__point [data-lucide] {
  width: 16px; height: 16px;
  color: var(--ui-color-primary); flex-shrink: 0;
  margin-top: 2px;
}
.hero-band__point strong { font-weight: 600; color: var(--ui-text-primary); }
.hero-band__point span { color: var(--ui-text-muted); margin-left: 6px; }
.hero-band__right { min-width: 0; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 StepPills (v3.8) 闂佽法鍠愰弸濠氬箯?鐎甸偊鍣ｉ弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊骞愰崶鈹夸粵闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷4 闁绘ǹ鍩栭埀顑挎祰瀹撳倿鏌ㄩ悢灏佸亾閻曞倻绀嗛梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氾拷 */
.step-pills {
  display: inline-flex; align-items: center; flex-wrap: wrap;
  gap: 6px;
}
.step-pill {
  display: inline-flex; align-items: center;
  padding: 4px 10px;
  border-radius: var(--ui-radius-pill);
  font-size: 11px; font-weight: 500; letter-spacing: 0.2px;
  white-space: nowrap;
}
.step-pill--done       { background: var(--ui-color-primary-subtle); color: var(--ui-color-primary); }
.step-pill--doneGreen  { background: var(--ui-badge-green-bg); color: var(--ui-badge-green-fg); }
.step-pill--current    { background: var(--ui-color-primary); color: var(--ui-text-on-brand); font-weight: 600; }
.step-pill--todo       { background: var(--ui-bg-muted); color: var(--ui-text-muted); }
.step-pill__sep {
  color: var(--ui-text-muted);
  font-size: 12px;
  user-select: none;
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 ProgressBar (v3.8) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯闁垮鍋撴笟鈧弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊宕㈤悢鍏兼櫢闁哄倶鍊栫€氾拷 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.progress-bar {
  width: 100%;
  background: var(--ui-bg-muted);
  border-radius: var(--ui-radius-pill);
  overflow: hidden;
}
.progress-bar__fill {
  height: 100%;
  border-radius: var(--ui-radius-pill);
  transition: width var(--ui-duration-base);
}
.progress-bar__fill--normal  { background: var(--ui-color-primary); }
.progress-bar__fill--warning { background: var(--ui-color-warning); }
.progress-bar__fill--danger  { background: var(--ui-color-destructive); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 DataTable (v3.7) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢?el-table + el-pagination闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
.data-table {
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-lg);
  overflow: hidden;
}
.data-table .el-table {
  border-radius: 0;
}
.data-table__pagination {
  padding: var(--ui-space-md) var(--ui-space-base);
  border-top: 1px solid var(--ui-border-soft);
  display: flex; justify-content: flex-end; align-items: center;
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Tag (v3.6) 闂佽法鍠愰弸濠氬箯?闂侇偅宀搁弫鎾绘儗椤愶絽鏁鹃柟鐑筋棑椤掞拷 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.tag {
  display: inline-flex; align-items: center; gap: 4px;
  height: 22px; padding: 3px 10px;
  border-radius: var(--ui-radius-pill);
  font-size: 11px; font-weight: 500; letter-spacing: 0.2px;
}
.tag [data-lucide] { width: 11px; height: 11px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 CardBox (v3.6) 闂佽法鍠愰弸濠氬箯?闂侇偅宀搁弫鎾绘儗椤愩垹鐨￠柟鐑筋棑婢ф牠鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.card-box {
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-lg);
}
.card-box__head {
  padding: var(--ui-space-md) var(--ui-space-base);
  border-bottom: 1px solid var(--ui-border-soft);
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--ui-space-sm);
}
.card-box__title { font-size: 14px; font-weight: 600; color: var(--ui-text-primary); }
.card-box__head-right { display: flex; align-items: center; gap: var(--ui-space-sm); }
.card-box__body { padding: var(--ui-space-base); }
.card-box--padded > .card-box__body { padding: var(--ui-space-lg); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Tabs (v3.6) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Tabs (underline + segmented) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.tabs-segmented {
  display: inline-flex;
  background: var(--ui-accent);
  border-radius: var(--ui-radius-lg);
  padding: 3px;
}
.tabs-segmented__item {
  padding: 6px 14px;
  font-size: 13px; font-weight: 500;
  color: var(--ui-text-muted);
  border-radius: var(--ui-radius-md);
  background: transparent;
  cursor: pointer;
  transition: background var(--ui-duration-fast), color var(--ui-duration-fast);
  display: inline-flex; align-items: center; gap: 6px;
  white-space: nowrap;
}
.tabs-segmented__item:hover { color: var(--ui-text-primary); }
.tabs-segmented__item.is-active {
  background: var(--ui-bg-card);
  color: var(--ui-text-primary);
  box-shadow: var(--ui-shadow-sm);
}
.tabs-segmented__count {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 18px; height: 16px; padding: 0 5px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-bg-muted);
  font-size: 10px; font-weight: 600;
  color: var(--ui-text-muted);
}
.tabs-segmented__item.is-active .tabs-segmented__count {
  background: var(--ui-color-primary-subtle);
  color: var(--ui-color-primary);
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 lux-tabs-page (v6.5 / B-Pro v4.1) 闂佽法鍠愰弸濠氬箯?濡炪倗鏁婚弫鎾绘嚍閵壯囩崜 Tab 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Stripe/Linear/Vercel 闂佽法鍠愰弸濠氬箯閻戣姤鏅�?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷
   闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柣顓у亾缂嶅洭骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀妴锟� 4+ 濞戞挴鍋撻梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲矗椤愶紕涓查柟椋庡厴閺佹捇寮妶鍡楊伓濞达絽绉归弫鎾诲棘閵堝棗顏� PageHeader 闂佽法鍠栭幗顏堝礄閵堝棗顏跺☉鎾亾闂佽法鍠庤ぐ銊╂晲韫囨柨顏�
   闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢铏瑰彄闁挎繂绻戠€氾拷2~3 闂佽法鍠愰弸濠氬箯瀹勬壆姣堥梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢宄板缓濞村吋鐟︾€氾拷 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯?.tabs-segmented (闂佽法鍠愯ぐ顔芥償閺囩姵顏ら柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?segmented control)
   闂佽法鍠愰弸濠氬箯閻戣姤鏅搁梻鍐啇缂嶅洭骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?PageHeader B-Pro 濞戞柨顑夐弫鎾绘煣鐢喚绉堕柟椋庡厴閺佹捇寮妶鍡楊伓闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌�?padding 8/28/0 + border-bottom hairline
        闂佽法鍠愰弸濠氬箯?active 闂佽法鍠栭幗顏呭濞嗘劕顏堕梺璺ㄥ枑閺嬪骞�?闂佽法鍠愰弸濠氬箯閻戣В鍋�?闂佽法鍠愰弸濠氬箯閻戣姤鏅哥紒鏃戝弿缂嶅洭骞忕粚鏈紃gin-bottom: -1px + ::after bottom: -1px闂佽法鍠愰弸濠氬箯?
   闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬湱鎷犻幘顔芥櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞�?user REQ-20260515 闁告ḿ鍠栭弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忔搴㈢獥闂佽法鍠愰弸濠氬箯?.lux-* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊宕滃鍥╃；闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 PageHeader B-Pro
            濞戞挴鍋撻梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氱懓顫忔导瀛樻櫢?designer 闂佽法鍠愰弸濠氬箯瀹勬澘娅欓梺璺ㄥ枑閺嬪骞忔搴ㄥ厙闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柟鎭掑劜閹锋繈骞忛悜鑺ユ櫢濡ゆ娅ｉ妴瀣箯閻戣姤鏅搁柡鍌樺€栫€氾拷 chrome 闂佽法鍠撳▓鏇熸綇閻愵剙顏堕梺璺ㄥ枑閺嬪骞�?.tabs-segmented
            闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊骞€娓氣偓閺佹捇寮妶鍡楊伓闁稿繈鍔戦弫鎾诲棘閵堝棗顏堕柛姘焸閺佹捇寮妶鍡楊伓闂佽法鍠栭幗顏呭濞嗘劕顏堕梺璺ㄥ枑閺嬪骞�?vs 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柟娲诲弿缂嶅洭骞�?*/
.lux-tabs-page {
  display: flex;
  align-items: stretch;
  gap: 2px;
  position: relative;
}
.lux-tabs-page button {
  position: relative;
  border: none;
  background: transparent;
  padding: 10px 12px 13px;
  margin-bottom: -1px;             /* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� border-bottom 闂佽法鍠愰崺鍛枈婢跺顏� */
  font-size: 14px;
  font-weight: 500;
  color: var(--ui-text-muted);
  cursor: pointer;
  font-family: inherit;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  letter-spacing: -0.005em;
  border-radius: 6px 6px 0 0;
  transition: color var(--ui-duration-fast), background var(--ui-duration-fast);
  z-index: 1;
  white-space: nowrap;
}
.lux-tabs-page button i[data-lucide],
.lux-tabs-page button svg {
  width: 15px !important;
  height: 15px !important;
  opacity: 0.7;
  transition: opacity var(--ui-duration-fast);
  flex-shrink: 0;
}
.lux-tabs-page button:hover:not(.is-active) {
  color: var(--ui-text-primary);
  background: var(--ui-accent);
}
.lux-tabs-page button:hover i[data-lucide],
.lux-tabs-page button:hover svg {
  opacity: 1;
}
.lux-tabs-page button.is-active {
  color: var(--ui-color-primary);
  font-weight: 600;
}
.lux-tabs-page button.is-active i[data-lucide],
.lux-tabs-page button.is-active svg {
  opacity: 1;
  color: var(--ui-color-primary);
}
.lux-tabs-page button.is-active::after {
  content: '';
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: -1px;
  height: 2px;
  background: var(--ui-color-primary);
  border-radius: 2px 2px 0 0;
  box-shadow: 0 0 0 0.5px var(--ui-color-primary);    /* 鐎甸偊鍣ｉ弫鎾诲棘閵堝棗顏堕梺璺ㄥ枙婵炲洭鏁愯箛鏂款伓retina 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
}
.lux-tabs-page button:focus-visible {
  outline: 2px solid var(--ui-color-primary);
  outline-offset: -3px;
  border-radius: 4px;
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Avatar (v3.6) 闂佽法鍠愰弸濠氬箯?闂佽法鍠撻悡顐ｅ濞嗘劕顏跺鑸垫尦閺佹捇寮妶鍡楊伓letter fallback闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
.avatar {
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: var(--ui-radius-pill);
  font-weight: 600;
  user-select: none;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.avatar-small   { width: 24px; height: 24px; font-size: 10px; }
.avatar-default { width: 32px; height: 32px; font-size: 12px; }
.avatar-large   { width: 40px; height: 40px; font-size: 14px; }
.avatar-xl      { width: 56px; height: 56px; font-size: 18px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 FilterBox (v3.9) 闂佽法鍠愰弸濠氬箯?缂佹稒鐩埀顒€顦甸弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� selection 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺锟�?Toolbar闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
.filter-box { display: flex; flex-wrap: wrap; gap: var(--ui-space-sm); align-items: flex-end; padding: var(--ui-space-md) 0; }
.filter-box .filter-actions { display: flex; gap: var(--ui-space-sm); margin-left: auto; }
.filter-box-spacer { flex: 1; min-width: 0; }
.filter-box--compact { padding: var(--ui-space-sm) 0; gap: var(--ui-space-xs); }
.filter-box--selection {
  padding: var(--ui-space-sm) var(--ui-space-base);
  background: var(--ui-color-primary-subtle);
  border: 1px solid var(--ui-color-primary);
  border-radius: var(--ui-radius-md);
  align-items: center;
}

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Breadcrumb (v3.10 L1) 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.breadcrumb {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 13px; color: var(--ui-text-muted);
}
.breadcrumb a {
  color: var(--ui-text-muted);
  transition: color var(--ui-duration-fast);
  cursor: pointer;
}
.breadcrumb a:hover { color: var(--ui-color-primary); }
.breadcrumb [data-lucide] { width: 13px; height: 13px; }
.breadcrumb-current { color: var(--ui-text-primary); font-weight: 500; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 DetailSection compact (v3.9) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲矗椤愮喐顫夐柟椋庡厴閺佹捇寮妶鍡楊伓闁绘碍鎼╅悡澶愬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?SectionTitle闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
.detail-section--compact { gap: var(--ui-space-sm); }
.detail-section--compact .detail-section__head {
  padding-left: 0;
  border-left: none;
  padding-bottom: var(--ui-space-sm);
  border-bottom: 1px solid var(--ui-border-soft);
}
.detail-section--compact .detail-section__title { font-size: 14px; font-weight: 600; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 ListCardItem (v3.9) 闂佽法鍠愰弸濠氬箯?闂佽法鍠庤ぐ銊╁箟鐎ｎ偄顏堕梺璺ㄥ枎瑜般劑宕犻埄鍐伓闁绘娲弫鎾诲棘閵堝棗顏堕梺璺ㄥ枙椤骞夌€ｎ偄顏堕柣褜鍨埀顒佸姍閺佹捇寮妶鍡楊伓闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌�?*/
.list-card-item { display: flex; align-items: center; gap: var(--ui-space-base); padding: var(--ui-space-md) var(--ui-space-base); border-radius: var(--ui-radius-lg); border: 1px solid transparent; transition: background var(--ui-duration-fast), border-color var(--ui-duration-fast); cursor: pointer; }
.list-card-item:hover { background: var(--ui-accent); }
.list-card-item--surface { background: var(--ui-bg-card); border-color: var(--ui-border-default); }
.list-card-item--surface:hover { border-color: var(--ui-color-primary); background: var(--ui-bg-card); box-shadow: var(--ui-shadow-sm); }
.list-card-item__lead { display: flex; align-items: center; gap: var(--ui-space-sm); flex-shrink: 0; }
.list-card-item__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.list-card-item__title { font-size: 14px; font-weight: 500; color: var(--ui-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: var(--ui-space-sm); }
.list-card-item__sub { font-size: 12px; color: var(--ui-text-muted); display: flex; align-items: center; gap: var(--ui-space-sm); }
.list-card-item__sub .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ui-border-strong); flex-shrink: 0; }
.list-card-item__row { display: flex; align-items: center; gap: var(--ui-space-sm); }
.list-card-item__label { font-size: 12px; color: var(--ui-text-muted); white-space: nowrap; }
.list-card-item__trail { display: flex; align-items: center; gap: var(--ui-space-sm); flex-shrink: 0; color: var(--ui-text-muted); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Upload (v3.9) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯闁垮顏奸梺璺ㄥ枑閺嬪骞�?+ 闂佽法鍠嶉懠搴ｆ兜闁垮顏堕梺璺ㄥ枑閺嬪骞�?4 闁绘ǹ鍩栭埀锟�?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.upload-zone { border: 1.5px dashed var(--ui-border-strong); border-radius: var(--ui-radius-lg); background: var(--ui-accent); padding: var(--ui-space-2xl) var(--ui-space-xl); display: flex; flex-direction: column; align-items: center; gap: var(--ui-space-sm); cursor: pointer; transition: border-color var(--ui-duration-fast), background var(--ui-duration-fast); text-align: center; }
.upload-zone:hover { border-color: var(--ui-color-primary); background: var(--ui-color-primary-subtle); }
.upload-zone--dragover { border-color: var(--ui-color-primary); background: var(--ui-color-primary-subtle); border-style: solid; }
.upload-zone__icon { width: 36px; height: 36px; border-radius: var(--ui-radius-md); background: var(--ui-bg-card); border: 1px solid var(--ui-border-default); display: flex; align-items: center; justify-content: center; color: var(--ui-color-primary); }
.upload-zone__icon [data-lucide] { width: 18px; height: 18px; }
.upload-zone__title { font-size: 14px; font-weight: 500; color: var(--ui-text-primary); }
.upload-zone__title strong { color: var(--ui-color-primary); }
.upload-zone__hint { font-size: 12px; color: var(--ui-text-muted); line-height: 1.6; }
.upload-list { display: flex; flex-direction: column; gap: var(--ui-space-sm); margin-top: var(--ui-space-md); }
.upload-item { display: flex; align-items: center; gap: var(--ui-space-sm); padding: var(--ui-space-sm) var(--ui-space-md); border: 1px solid var(--ui-border-default); border-radius: var(--ui-radius-md); background: var(--ui-bg-card); }
.upload-item__icon { width: 28px; height: 28px; border-radius: var(--ui-radius-sm); background: var(--ui-accent); display: flex; align-items: center; justify-content: center; color: var(--ui-text-muted); flex-shrink: 0; }
.upload-item__icon [data-lucide] { width: 14px; height: 14px; }
.upload-item__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.upload-item__name { font-size: 13px; color: var(--ui-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.upload-item__meta { font-size: 11px; color: var(--ui-text-muted); display: flex; gap: 6px; align-items: center; font-family: var(--ui-font-mono); }
.upload-item__status { font-size: 11px; font-weight: 500; flex-shrink: 0; }
.upload-item--done { background: var(--ui-color-success-subtle); border-color: var(--ui-color-success); }
.upload-item--done .upload-item__icon { background: var(--ui-color-success); color: var(--ui-text-on-brand); }
.upload-item--done .upload-item__status { color: var(--ui-color-success); }
.upload-item--error { background: var(--ui-color-destructive-subtle); border-color: var(--ui-color-destructive); }
.upload-item--error .upload-item__icon { background: var(--ui-color-destructive); color: var(--ui-text-on-brand); }
.upload-item--error .upload-item__status { color: var(--ui-color-destructive); }
.upload-item__close { color: var(--ui-text-muted); padding: 4px; transition: color var(--ui-duration-fast); flex-shrink: 0; background: none; border: none; cursor: pointer; line-height: 0; }
.upload-item__close:hover { color: var(--ui-color-destructive); }
.upload-item__close [data-lucide] { width: 14px; height: 14px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Skeleton (v3.9) 闂佽法鍠愰弸濠氬箯?闂佽法鍠栧Ο浣糕枎閿涘嫨鈧骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊宕￠悩杈╃Т闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 shimmer 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柟瀛樺笩缁绘洟宕㈤悢鍏兼櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕柣妯虹埣閺佹捇寮妶鍡楊伓闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
@keyframes ds-skeleton-shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
.skeleton-bar, .skeleton-circle {
  background: linear-gradient(90deg, var(--ui-accent) 25%, var(--ui-bg-muted) 50%, var(--ui-accent) 75%);
  background-size: 200% 100%;
  animation: ds-skeleton-shimmer 1.6s ease-in-out infinite;
  border-radius: var(--ui-radius-sm);
}
.skeleton-bar { height: 12px; width: 100%; }
.skeleton-bar--sm { height: 10px; }
.skeleton-bar--lg { height: 24px; border-radius: var(--ui-radius-md); }
.skeleton-circle { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; }
.skeleton-circle--sm { width: 24px; height: 24px; }
.skeleton-row { display: flex; align-items: center; gap: var(--ui-space-base); padding: var(--ui-space-md) 0; border-bottom: 1px solid var(--ui-border-soft); }
.skeleton-row:last-child { border-bottom: none; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 I18nField (v3.10 L2 鐎殿喗妞介弫鎾诲棘閵堝棗顏�) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾舵偘濡や緡鍞介柨婵嗙箲鐎氱瓗abs 闂佽法鍠庤ぐ銊﹀濞嗘劕顏� + 闁革箑妫濋弫鎾诲棘閵堝棗顏堕柣妯垮煐閳ь兛绶氶弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鎯板闁挎繂绻戠€氾拷 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
@keyframes i18n-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.i18n-status-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
.i18n-status-dot--done     { background: var(--ui-color-success); }
.i18n-status-dot--missing  { background: var(--ui-text-muted); opacity: 0.4; }
.i18n-status-dot--required { background: var(--ui-color-destructive); animation: i18n-pulse 1.5s ease-in-out infinite; }
.i18n-field { display: flex; flex-direction: column; gap: 6px; }
.i18n-field__tabs { display: inline-flex; gap: 2px; padding: 3px; background: var(--ui-accent); border-radius: var(--ui-radius-md); align-self: flex-start; max-width: 100%; flex-wrap: wrap; }
.i18n-field__tab { padding: 6px 14px; border-radius: var(--ui-radius-sm); font-size: 12px; font-weight: 500; color: var(--ui-text-muted); display: inline-flex; align-items: center; gap: 8px; cursor: pointer; background: transparent; border: none; transition: background var(--ui-duration-fast), color var(--ui-duration-fast); white-space: nowrap; }
.i18n-field__tab:hover { color: var(--ui-text-primary); }
.i18n-field__tab.is-active { background: var(--ui-bg-card); color: var(--ui-text-primary); box-shadow: var(--ui-shadow-sm); }
.i18n-field__tab-name { font-weight: 500; }
.i18n-field__tab-required { font-size: 9px; color: var(--ui-color-destructive); font-weight: 700; letter-spacing: 0.04em; }
.i18n-field__progress { font-size: 11px; color: var(--ui-text-muted); margin-top: 4px; display: flex; align-items: center; gap: 6px; }
.i18n-field__progress [data-lucide] { width: 12px; height: 12px; color: var(--ui-color-success); }
.i18n-field__progress--has-missing { color: var(--ui-color-destructive); }
.i18n-field__progress--has-missing [data-lucide] { color: var(--ui-color-destructive); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Form Modern (v3.10 L2 鐎殿喗妞介弫鎾诲棘閵堝棗顏�) 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 el-form 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� .form-modern 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
.form-modern .el-form { display: flex; flex-direction: column; gap: var(--ui-space-md); }
.form-modern .el-form-item { display: block !important; margin-bottom: 24px; }
.form-modern .el-form-item__label {
  display: block !important;
  width: auto !important;
  text-align: left !important;
  padding: 0 0 6px !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  color: var(--ui-text-primary) !important;
  line-height: 1.4 !important;
}
.form-modern .el-form-item__content { margin-left: 0 !important; width: 100%; display: block !important; }
.form-modern .form-helper { display: block; font-size: 12px; color: var(--ui-text-muted); line-height: 1.5; margin-top: -4px; margin-bottom: 8px; }
.form-modern .el-input__wrapper,
.form-modern .el-select__wrapper,
.form-modern .el-textarea__inner {
  border-radius: 8px !important;
  transition: box-shadow var(--ui-duration-fast) var(--ui-ease-out) !important;
}
.form-modern .el-input__wrapper.is-focus,
.form-modern .el-select__wrapper.is-focused,
.form-modern .el-textarea__inner:focus {
  box-shadow: 0 0 0 1px var(--ui-color-primary) inset, 0 0 0 3px rgba(95, 78, 207, 0.15) !important;
}
.form-modern .el-form-item__error { display: inline-flex !important; align-items: center; gap: 4px; padding-top: 6px !important; font-size: 12px !important; }
.form-modern .el-form-item__error::before { content: '?'; font-size: 12px; margin-right: 2px; }

/* Form Group 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯妞嬪骸顣婚梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
.form-group { background: var(--ui-bg-card); border: 1px solid var(--ui-border-default); border-radius: var(--ui-radius-xl); padding: var(--ui-space-lg) var(--ui-space-xl); margin-bottom: var(--ui-space-lg); }
.form-group__head { display: flex; align-items: center; gap: 8px; padding-bottom: var(--ui-space-md); border-bottom: 1px solid var(--ui-border-soft); margin-bottom: var(--ui-space-base); }
.form-group__head [data-lucide] { width: 16px; height: 16px; color: var(--ui-color-primary); }
.form-group__title { font-size: 14px; font-weight: 600; color: var(--ui-text-primary); }
.form-group__hint { font-size: 12px; color: var(--ui-text-muted); margin-left: auto; }

/* Form actions 闂佽法鍠愰弸濠氬箯?闂佽法鍠撶划銊︾閵堝鏅搁柡鍌樺€栫€氾拷 */
.form-actions { display: flex; justify-content: flex-end; gap: var(--ui-space-sm); padding-top: var(--ui-space-md); margin-top: var(--ui-space-md); border-top: 1px solid var(--ui-border-soft); }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Radio 闂佽法鍠愰弸濠氬箯?4 variant (v3.10 L2闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氱懓顫�?EP 濮掓稒锕㈤弫鎾存綇閸愯法绉堕柟椋庡厴閺佹捇寮妶鍡楊伓闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺锟�? 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 */
/* .radio-circle 闂佽法鍠愰弸濠氬箯?A 濮掓稒锕㈤弫鎾存綇閸愯法绉堕柟宄板槻濞撻箖鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏�90% 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?*/
.radio-circle { display: flex; flex-direction: column; gap: var(--ui-space-sm); }
.radio-circle__item { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; padding: 4px 0; transition: color var(--ui-duration-fast); }
.radio-circle__item:hover { color: var(--ui-color-primary); }
.radio-circle__dot { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--ui-border-strong); background: var(--ui-bg-card); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; transition: border-color var(--ui-duration-fast); position: relative; }
.radio-circle__dot::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--ui-color-primary); opacity: 0; transform: scale(0.4); transition: opacity var(--ui-duration-fast) var(--ui-ease-out), transform var(--ui-duration-fast) var(--ui-ease-spring); }
.radio-circle__item:hover .radio-circle__dot { border-color: var(--ui-color-primary); }
.radio-circle__item.is-active .radio-circle__dot { border-color: var(--ui-color-primary); }
.radio-circle__item.is-active .radio-circle__dot::after { opacity: 1; transform: scale(1); }
.radio-circle__label { font-size: 14px; color: var(--ui-text-primary); line-height: 1.4; }

/* .radio-pill 闂佽法鍠愰弸濠氬箯?B 闁肩瓔鍨堕弫鎾诲磹閻曞倻绀勯梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁煎瓨纰嶉弸濠氬箯妞嬪孩韬梺锟�?*/
.radio-pill-group { display: inline-flex; gap: 6px; flex-wrap: wrap; }
.radio-pill { padding: 7px 16px; border-radius: var(--ui-radius-pill); border: 1px solid var(--ui-border-default); background: var(--ui-bg-card); cursor: pointer; font-size: 13px; font-weight: 500; color: var(--ui-text-secondary); transition: background var(--ui-duration-fast), border-color var(--ui-duration-fast), color var(--ui-duration-fast); white-space: nowrap; }
.radio-pill:hover { border-color: var(--ui-border-strong); color: var(--ui-text-primary); }
.radio-pill.is-active { background: var(--ui-color-primary-subtle); border-color: var(--ui-color-primary); color: var(--ui-color-primary); font-weight: 600; }

/* .radio-segmented 闂佽法鍠愰弸濠氬箯?C 闂佽法鍠曢、婊冣枔闂堟稑鐨￠柟椋庡厴閺佹捇鎮埥鍛Ф闁归饪窸S 闂佽法鍠撻弲顐︽晬?-4 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鎮╅懜纰樺亾娓氣偓閺佹捇寮妶鍡楊伓 */
.radio-segmented { display: inline-flex; padding: 3px; background: var(--ui-accent); border-radius: var(--ui-radius-md); }
.radio-segmented__item { padding: 7px 16px; border-radius: var(--ui-radius-sm); cursor: pointer; font-size: 13px; font-weight: 500; color: var(--ui-text-muted); transition: background var(--ui-duration-fast), color var(--ui-duration-fast), box-shadow var(--ui-duration-fast); border: none; background: transparent; white-space: nowrap; }
.radio-segmented__item:hover { color: var(--ui-text-primary); }
.radio-segmented__item.is-active { background: var(--ui-bg-card); color: var(--ui-text-primary); box-shadow: var(--ui-shadow-sm); font-weight: 600; }

/* .radio-card 闂佽法鍠愰弸濠氬箯?D Card Radio闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枍閼煎酣宕楀畷鍥モ偓瀣箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢渚痪闁挎繂绻戠€氾拷 */
.radio-card-group { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--ui-space-sm); }
.radio-card { position: relative; padding: 12px 14px; border: 1px solid var(--ui-border-default); border-radius: var(--ui-radius-lg); background: var(--ui-bg-card); cursor: pointer; transition: border-color var(--ui-duration-fast), box-shadow var(--ui-duration-fast); }
.radio-card:hover { border-color: var(--ui-border-strong); }
.radio-card.is-active { border-color: var(--ui-color-primary); box-shadow: 0 0 0 1px var(--ui-color-primary), 0 0 0 4px rgba(95, 78, 207, 0.12); }
.radio-card__dot { position: absolute; top: 12px; right: 12px; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--ui-border-strong); background: var(--ui-bg-card); transition: background var(--ui-duration-fast), border-color var(--ui-duration-fast), box-shadow var(--ui-duration-fast); }
.radio-card.is-active .radio-card__dot { background: var(--ui-color-primary); border-color: var(--ui-color-primary); box-shadow: inset 0 0 0 4px var(--ui-bg-card); }
.radio-card__name { font-size: 13px; font-weight: 600; color: var(--ui-text-primary); padding-right: 24px; line-height: 1.4; }
.radio-card__desc { font-size: 11px; color: var(--ui-text-muted); margin-top: 4px; line-height: 1.5; padding-right: 24px; }

/* 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏�
 * Motion 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鎭嶆帡鏁嶉崸锟�3.10闂佽法鍠愰弸濠氬箯?
 * keyframes + 6 preset class + stagger 闂佽法鍠愮敮瀵哥驳鐟欏嫬顏堕梺璺ㄥ枑閺嬪骞�?
 * 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� */

@keyframes anim-fade-in        { from { opacity: 0; }                              to { opacity: 1; } }
@keyframes anim-fade-out       { from { opacity: 1; }                              to { opacity: 0; } }
@keyframes anim-slide-in-right { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
@keyframes anim-slide-in-up    { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
@keyframes anim-scale-in       { from { opacity: 0; transform: scale(0.96); }      to { opacity: 1; transform: scale(1); } }

.anim-fade-in        { animation: anim-fade-in        var(--ui-duration-base) var(--ui-ease-out)  both; }
.anim-fade-out       { animation: anim-fade-out       var(--ui-duration-base) var(--ui-ease-in)   both; }
.anim-slide-in-right { animation: anim-slide-in-right var(--ui-duration-slow) var(--ui-ease-out)  both; }
.anim-slide-in-up    { animation: anim-slide-in-up    var(--ui-duration-slow) var(--ui-ease-out)  both; }
.anim-scale-in       { animation: anim-scale-in       var(--ui-duration-base) var(--ui-ease-out)  both; }

/* stagger 闂佽法鍠愮敮瀵哥驳鐟欏嫬顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� .anim-stagger闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊宕楅崘顔芥櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鐑樼暦閻犱浇顫夌€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀妴搴ㄦ煥閻斿憡鐏柟椋庡厴閺佹捇鎸婃径瀣獥闂佽法鍠曢鐘绘晬?0ms 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷*/
.anim-stagger > * { animation: anim-fade-in var(--ui-duration-base) var(--ui-ease-out) both; }
.anim-stagger > *:nth-child(1)  { animation-delay:   0ms; }
.anim-stagger > *:nth-child(2)  { animation-delay:  30ms; }
.anim-stagger > *:nth-child(3)  { animation-delay:  60ms; }
.anim-stagger > *:nth-child(4)  { animation-delay:  90ms; }
.anim-stagger > *:nth-child(5)  { animation-delay: 120ms; }
.anim-stagger > *:nth-child(6)  { animation-delay: 150ms; }
.anim-stagger > *:nth-child(7)  { animation-delay: 180ms; }
.anim-stagger > *:nth-child(8)  { animation-delay: 210ms; }
.anim-stagger > *:nth-child(9)  { animation-delay: 240ms; }
.anim-stagger > *:nth-child(10) { animation-delay: 270ms; }

/* 缂侇垵宕电划娲煥閻斿憡鐏柟椋庡厴閺佹捇寮妶鍡楊伓 prefers-reduced-motion 闁哄啫鐖奸弫鎾诲箣椤忓棭鏆滈柟椋庢焿椤ュ﹪鏌ㄩ悢璇测枏閻犱浇顫夌€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢绋跨枂妞ゅ氦娉涢崺锟狀敆婵犲啫顏堕梺锟�?*/
@media (prefers-reduced-motion: reduce) {
  .anim-fade-in, .anim-fade-out, .anim-slide-in-right, .anim-slide-in-up,
  .anim-scale-in, .anim-stagger > * { animation: none !important; }
}

.deploy-canvas-page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--ui-space-lg);
  padding: calc(var(--ui-space-2xl) + var(--ui-space-sm)) var(--ui-space-2xl) var(--ui-space-2xl);
  color: var(--ui-text-primary);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--ui-color-primary) 12%, transparent), transparent 42%),
    var(--ui-bg-page);
}

.canvas-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: var(--ui-space-xl);
}

.canvas-title-wrap {
  display: flex;
  gap: var(--ui-space-md);
  align-items: center;
}

.canvas-back {
  width: calc(var(--ui-space-xl) * 2);
  height: calc(var(--ui-space-xl) * 2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-bg-card);
  color: var(--ui-text-secondary);
}

.canvas-stepper {
  display: flex;
  align-items: center;
  gap: var(--ui-space-xl);
  padding: var(--ui-space-xl) var(--ui-space-2xl);
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-xl);
  background: var(--ui-bg-card);
  box-shadow: var(--ui-shadow-sm);
}

.canvas-step {
  position: relative;
  flex: 1 1 0;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: var(--ui-space-md);
  align-items: center;
  min-width: 0;
}

.canvas-step:not(:last-child)::after {
  content: "";
  position: absolute;
  inset-inline-start: calc(100% + calc(var(--ui-space-xl) * 0.5));
  top: 50%;
  width: calc(var(--ui-space-xl) * 1.5);
  height: 1px;
  background: var(--ui-border-default);
  transform: translateX(0);
}

.canvas-step.is-done::after,
.canvas-step.is-current::after {
  background: color-mix(in srgb, var(--ui-color-primary) 58%, var(--ui-border-default));
}

.canvas-step-dot {
  width: calc(var(--ui-space-xl) * 2);
  height: calc(var(--ui-space-xl) * 2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ui-border-default);
  border-radius: var(--ui-radius-pill);
  background: var(--ui-bg-card);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-size-lg);
  font-weight: 700;
}

.canvas-step-dot .lucide {
  width: var(--ui-space-lg);
  height: var(--ui-space-lg);
}

.canvas-step.is-done .canvas-step-dot,
.canvas-step.is-current .canvas-step-dot {
  border-color: var(--ui-color-primary);
  background: var(--ui-color-primary);
  color: var(--ui-text-on-brand);
}

.canvas-step-title {
  color: var(--ui-text-secondary);
  font-weight: 700;
}

.canvas-step.is-done .canvas-step-title,
.canvas-step.is-current .canvas-step-title {
  color: var(--ui-text-primary);
}

.canvas-board {
  display: grid;
  grid-template-columns: minmax(calc(var(--ui-space-3xl) * 6), calc(var(--ui-space-3xl) * 8)) minmax(0, 1fr);
  gap: var(--ui-space-lg);
  align-items: start;
}

.canvas-board.is-empty {
  grid-template-columns: minmax(calc(var(--ui-space-3xl) * 6), calc(var(--ui-space-3xl) * 8)) minmax(0, 1fr);
}

.deploy-empty-board {
  display: grid;
  place-items: center;
  min-height: clamp(430px, calc(100vh - 380px), 620px);
  padding: calc(var(--ui-space-3xl) * 1.35) var(--ui-space-2xl);
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-xl);
  background:
    radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--ui-color-primary) 8%, transparent), transparent 36%),
    linear-gradient(180deg, color-mix(in srgb, var(--ui-color-primary) 4%, var(--ui-bg-card)), var(--ui-bg-card));
  box-shadow: var(--ui-shadow-sm);
}

.deploy-empty-board__inner {
  max-width: 560px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--ui-space-base);
  text-align: center;
}

.deploy-empty-board__icon {
  width: calc(var(--ui-space-3xl) * 1.25);
  height: calc(var(--ui-space-3xl) * 1.25);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 9%, var(--ui-bg-card));
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 24%, var(--ui-border-soft));
  box-shadow: 0 10px 24px color-mix(in srgb, var(--ui-color-primary) 12%, transparent);
}

.deploy-empty-board__icon svg {
  width: 28px;
  height: 28px;
}

.deploy-empty-board__copy {
  display: grid;
  gap: var(--ui-space-sm);
  justify-items: center;
}

.deploy-empty-board__title {
  color: var(--ui-text-primary);
  font-size: 20px;
  font-weight: 700;
  line-height: 1.35;
}

.deploy-empty-board__desc {
  max-width: min(640px, 92vw);
  color: var(--ui-text-muted);
  line-height: 1.7;
  white-space: nowrap;
}

@media (max-width: 78rem) {
  .deploy-empty-board__desc {
    white-space: normal;
  }
}

.deploy-empty-board__actions {
  margin-top: var(--ui-space-xs);
}

.deploy-empty-board__actions .el-button {
  min-width: 148px;
}

.canvas-panel,
.canvas-inspector {
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-xl);
  background: var(--ui-bg-card);
  box-shadow: var(--ui-shadow-sm);
}

.canvas-panel {
  display: flex;
  flex-direction: column;
  align-self: start;
  overflow: hidden;
}

.canvas-panel-head {
  padding: var(--ui-space-lg) var(--ui-space-lg) var(--ui-space-base);
  border-bottom: 1px solid var(--ui-border-soft);
}

.canvas-panel-head__main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  min-width: 0;
  flex: 1 1 auto;
}

.canvas-panel-head__main .type-h3,
.canvas-panel-head__main .type-caption {
  white-space: normal;
}

.panel-head-with-action {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ui-space-md);
  min-height: 0;
}

.canvas-scope-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: var(--ui-space-md);
}

.canvas-scope-list.is-empty {
  padding: var(--ui-space-lg);
}

.canvas-scope-scroll {
  flex: none;
  height: auto;
  max-height: min(520px, calc(100vh - 360px));
}

.scope-pill {
  position: relative;
  display: grid;
  align-items: center;
  min-height: 68px;
  padding: 14px 12px 10px;
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-lg);
  background: color-mix(in srgb, var(--ui-bg-card) 92%, var(--ui-bg-muted));
  cursor: pointer;
  transition: border-color var(--ui-duration-fast), background var(--ui-duration-fast), box-shadow var(--ui-duration-fast);
}

.scope-pill__main {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  width: 100%;
}

.scope-pill__title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ui-text-muted);
  font-size: 14px;
  line-height: 1.35;
}

.scope-pill__aside {
  display: flex;
  align-items: center;
  justify-self: end;
  gap: 6px;
  width: 22px;
  min-height: 1px;
}

.scope-corner-actions {
  position: absolute;
  top: 8px;
  right: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 1;
}

.scope-status-tag {
  height: auto;
  min-height: auto;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0;
  white-space: nowrap;
}

.scope-status-tag::before {
  content: "";
  width: 5px;
  height: 5px;
  flex-shrink: 0;
  border-radius: var(--ui-radius-pill);
  background: currentColor;
  opacity: .72;
}

.scope-pill:hover {
  border-color: color-mix(in srgb, var(--ui-color-primary) 32%, var(--ui-border-soft));
  background: color-mix(in srgb, var(--ui-color-primary) 4%, var(--ui-bg-card));
}

.scope-pill.is-active {
  border-color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 7%, var(--ui-bg-card));
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--ui-color-primary) 10%, transparent);
}

.scope-brand-mark {
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-bg-card);
  border: 1px solid var(--ui-border-soft);
  color: var(--ui-text-muted);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0;
  box-shadow: var(--ui-shadow-sm);
}

.scope-brand-mark[data-cloud="aliyun"] {
  color: #ff6a00;
  font-size: 0;
}

.scope-brand-mark[data-cloud="aliyun"]::before {
  content: "";
  width: 24px;
  height: 24px;
  border: 5px solid #ff6a00;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 6px;
}

.scope-brand-mark[data-cloud="aws"] {
  color: #232f3e;
}

.scope-brand-mark[data-cloud="google"] {
  color: #4285f4;
}

.scope-brand-mark[data-cloud="huawei"] {
  color: #c7000b;
}

.scope-brand-mark[data-cloud="agione"] {
  color: var(--ui-color-primary);
}

.scope-pill.is-active .scope-brand-mark {
  border-color: color-mix(in srgb, var(--ui-color-primary) 32%, var(--ui-border-soft));
  background: var(--ui-bg-card);
}

.scope-pill__cloud {
  color: var(--ui-text-primary);
  font-size: 14px;
  font-weight: 700;
}

.scope-pill__region {
  color: var(--ui-text-muted);
  font-size: 14px;
  font-weight: 500;
}

.scope-remove {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-sm);
  color: var(--ui-text-muted);
  background: color-mix(in srgb, var(--ui-bg-card) 84%, transparent);
  opacity: .72;
  transition: opacity var(--ui-duration-fast) var(--ui-ease-out),
              color var(--ui-duration-fast) var(--ui-ease-out),
              background var(--ui-duration-fast) var(--ui-ease-out),
              border-color var(--ui-duration-fast) var(--ui-ease-out);
}

.scope-remove-wrap {
  position: absolute;
  right: 12px;
  bottom: 8px;
  display: inline-flex;
  opacity: 0;
  pointer-events: none;
  transform: translateY(2px);
  transition: opacity var(--ui-duration-fast) var(--ui-ease-out),
              transform var(--ui-duration-fast) var(--ui-ease-out);
}

.scope-pill.is-active .scope-remove:not(:hover),
.scope-remove:focus:not(:hover) {
  color: var(--ui-text-muted);
  background: color-mix(in srgb, var(--ui-bg-card) 84%, transparent);
  border-color: var(--ui-border-soft);
  opacity: .72;
}

.scope-pill.is-active .scope-remove-wrap {
  opacity: .62;
  pointer-events: auto;
  transform: translateY(0);
}

.scope-pill:hover .scope-remove-wrap,
.scope-remove-wrap:focus-within {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.scope-remove:hover {
  opacity: 1;
  color: var(--ui-color-destructive);
  background: color-mix(in srgb, var(--ui-color-destructive) 10%, var(--ui-bg-card));
  border-color: color-mix(in srgb, var(--ui-color-destructive) 28%, var(--ui-border-soft));
}

.scope-remove [data-lucide] {
  width: 13px;
  height: 13px;
}

.canvas-stage-rail {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--ui-space-sm);
}

.canvas-stage-step {
  display: flex;
  gap: var(--ui-space-sm);
  align-items: center;
  padding: var(--ui-space-sm);
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-bg-muted);
}

.canvas-stage-step > div {
  min-width: 0;
}

.canvas-stage-step.is-current {
  border-color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 12%, var(--ui-bg-card));
}

.canvas-stage-step.is-done {
  border-color: color-mix(in srgb, var(--ui-color-success) 45%, var(--ui-border-soft));
  background: color-mix(in srgb, var(--ui-color-success) 8%, var(--ui-bg-card));
}

.stage-marker {
  width: calc(var(--ui-space-lg) + var(--ui-space-sm));
  height: calc(var(--ui-space-lg) + var(--ui-space-sm));
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-bg-card);
  color: var(--ui-text-muted);
}

.canvas-stage-step.is-current .stage-marker {
  background: var(--ui-color-primary);
  color: var(--ui-text-on-brand);
}

.canvas-stage-step.is-done .stage-marker {
  background: var(--ui-color-success-subtle);
  color: var(--ui-color-success);
}

.canvas-inspector {
  display: flex;
  flex-direction: column;
}

.canvas-detail {
  display: flex;
  flex-direction: column;
}

.inspector-head {
  padding: var(--ui-space-lg);
  border-bottom: 1px solid var(--ui-border-soft);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--ui-color-primary) 18%, transparent), transparent),
    var(--ui-bg-card);
}

.detail-head-row {
  display: flex;
  justify-content: space-between;
  gap: var(--ui-space-lg);
  align-items: flex-start;
}

.detail-meta-strip {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ui-space-sm);
  margin-top: var(--ui-space-md);
}

.detail-meta-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--ui-space-xs);
  min-height: calc(var(--ui-space-xl) * 1.35);
  padding: 0 var(--ui-space-md);
  border-radius: var(--ui-radius-pill);
  background: color-mix(in srgb, var(--ui-color-primary) 8%, var(--ui-bg-card));
  color: var(--ui-text-secondary);
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 22%, var(--ui-border-soft));
}

.detail-stage-rail {
  display: flex;
  align-items: center;
  gap: var(--ui-space-sm);
  margin-top: var(--ui-space-md);
  color: var(--ui-text-muted);
  font-size: 12px;
  line-height: 1.4;
  flex-wrap: wrap;
}

.detail-stage-node {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 2px 0;
  color: var(--ui-text-muted);
  font-weight: 500;
}

.detail-stage-node .detail-stage-label {
  letter-spacing: 0.01em;
}

.detail-stage-node.is-done {
  color: var(--ui-text-primary);
}

.detail-stage-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-border-strong);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--ui-border-strong) 18%, transparent);
  transition: background var(--ui-duration-fast), box-shadow var(--ui-duration-fast);
}

.detail-stage-node.is-done .detail-stage-dot {
  background: var(--ui-color-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--ui-color-primary) 22%, transparent);
}

.detail-stage-link {
  flex: 0 0 24px;
  height: 1px;
  background: var(--ui-border-default);
  transition: background var(--ui-duration-fast);
}

.detail-stage-link.is-done {
  background: var(--ui-color-primary);
}

.inspector-body {
  display: flex;
  flex-direction: column;
  gap: var(--ui-space-lg);
  padding: var(--ui-space-lg);
}

.record-empty-state {
  display: flex;
  min-height: calc(var(--ui-space-3xl) * 3);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--ui-space-sm);
  padding: var(--ui-space-xl);
  text-align: center;
  border: 1px dashed var(--ui-border-default);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-bg-muted);
}

.record-empty-state.is-scope-empty {
  min-height: 168px;
  border-color: color-mix(in srgb, var(--ui-color-primary) 16%, var(--ui-border-soft));
  background: color-mix(in srgb, var(--ui-bg-muted) 68%, var(--ui-bg-card));
}

.record-empty-state.is-wide {
  min-height: calc(var(--ui-space-3xl) * 7);
}

.record-empty-icon {
  width: calc(var(--ui-space-xl) * 2);
  height: calc(var(--ui-space-xl) * 2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 10%, var(--ui-bg-card));
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 28%, var(--ui-border-soft));
}

.record-empty-icon svg {
  width: 22px;
  height: 22px;
}

.global-empty-state {
  min-height: clamp(380px, calc(100vh - 500px), 520px);
  display: grid;
  place-items: center;
  padding: calc(var(--ui-space-3xl) * 1.35) var(--ui-space-2xl);
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 14%, var(--ui-border-soft));
  border-radius: var(--ui-radius-xl);
  background:
    radial-gradient(circle at 50% 32%, color-mix(in srgb, var(--ui-color-primary) 8%, transparent), transparent 35%),
    linear-gradient(180deg, color-mix(in srgb, var(--ui-color-primary) 3%, var(--ui-bg-card)), color-mix(in srgb, var(--ui-bg-muted) 68%, var(--ui-bg-card)));
}

.global-empty-state__inner {
  max-width: 500px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--ui-space-base);
  text-align: center;
  transform: translateY(-4px);
}

.global-empty-state__icon {
  width: calc(var(--ui-space-3xl) * 1.2);
  height: calc(var(--ui-space-3xl) * 1.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 8%, var(--ui-bg-card));
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 22%, var(--ui-border-soft));
  box-shadow: 0 10px 24px color-mix(in srgb, var(--ui-color-primary) 12%, transparent);
}

.global-empty-state__icon svg {
  width: 26px;
  height: 26px;
}

.global-empty-state__copy {
  display: grid;
  gap: var(--ui-space-sm);
  justify-items: center;
}

.global-empty-state__title {
  color: var(--ui-text-primary);
  font-size: 18px;
  font-weight: 700;
  line-height: 1.4;
}

.global-empty-state__desc {
  max-width: 480px;
  color: var(--ui-text-muted);
  line-height: 1.7;
}

.global-empty-state__actions {
  margin-top: 2px;
}

.global-empty-state__actions .el-button {
  min-width: 148px;
}

.detail-record-body {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0;
  border-top: 1px solid var(--ui-border-soft);
}

.detail-record-body .detail-card {
  border-left: 0;
  border-right: 0;
  border-bottom: 0;
  border-radius: 0;
  padding: var(--ui-space-lg);
  background: transparent;
}

.detail-record-body .detail-card + .detail-card {
  border-top: 1px solid var(--ui-border-soft);
}

.detail-card {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--ui-space-sm);
  padding: var(--ui-space-md);
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-xl);
  background: var(--ui-bg-card);
}

.detail-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ui-space-md);
}

.detail-card__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: var(--ui-space-sm);
}

.detail-card__title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--ui-space-sm);
}

.detail-card__icon {
  width: calc(var(--ui-space-xl) * 1.6);
  height: calc(var(--ui-space-xl) * 1.6);
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-lg);
  color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 10%, var(--ui-bg-card));
}

.detail-card__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: var(--ui-space-sm);
  min-height: calc(var(--ui-space-3xl) * 2.65);
  padding: var(--ui-space-lg);
  text-align: center;
  border: 1px dashed color-mix(in srgb, var(--ui-color-primary) 20%, var(--ui-border-soft));
  border-radius: var(--ui-radius-lg);
  background: color-mix(in srgb, var(--ui-color-primary) 3%, var(--ui-bg-card));
}

.detail-card__empty-icon {
  width: calc(var(--ui-space-xl) * 1.7);
  height: calc(var(--ui-space-xl) * 1.7);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: color-mix(in srgb, var(--ui-color-primary) 82%, var(--ui-text-muted));
  background: color-mix(in srgb, var(--ui-color-primary) 8%, var(--ui-bg-card));
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 18%, var(--ui-border-soft));
}

.detail-card__empty-text {
  max-width: 420px;
  color: color-mix(in srgb, var(--ui-text-muted) 86%, var(--ui-text-secondary));
}

.kv-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.kv-value-mono {
  display: block;
  max-height: calc(var(--ui-space-3xl) * 1.6);
  padding: var(--ui-space-sm);
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-md);
  background: var(--ui-bg-muted);
  font-family: var(--ui-font-mono);
  font-size: 12px;
  line-height: 1.55;
  overflow-wrap: anywhere;
  overflow: auto;
}

.kv-inline-action {
  display: inline-flex;
  align-items: center;
  gap: var(--ui-space-sm);
  min-width: 0;
}

.model-intake-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--ui-space-sm);
  margin-top: var(--ui-space-xs);
}

.model-intake-field {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 4px;
  min-height: 64px;
  padding: var(--ui-space-sm) var(--ui-space-md);
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-lg);
  background: color-mix(in srgb, var(--ui-bg-muted) 54%, var(--ui-bg-card));
}

.model-intake-field.is-wide {
  grid-column: span 2;
}

.model-intake-field.is-full {
  grid-column: 1 / -1;
}

.model-intake-command {
  grid-column: 1 / -1;
  margin-top: 0;
}

.model-intake-label {
  color: var(--ui-text-muted);
  font-size: 12px;
  line-height: 1.35;
}

.model-intake-value {
  min-width: 0;
  color: var(--ui-text-primary);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.model-intake-field--compact {
  min-height: 56px;
  background: color-mix(in srgb, var(--ui-bg-card) 72%, var(--ui-bg-muted));
}

.model-source-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--ui-text-primary);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
}

.model-source-status__icon {
  width: 14px;
  height: 14px;
  color: var(--ui-color-primary);
  flex: 0 0 auto;
}

.detail-card .inspector-kv {
  padding: var(--ui-space-xs) 0;
}

.resource-stack {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--ui-space-lg);
}

.resource-block {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--ui-space-sm);
}

.resource-block__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-space-md);
}

.inspector-task {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--ui-space-md);
  padding: var(--ui-space-md);
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-bg-muted);
}

.inspector-task.is-current {
  border-color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 12%, var(--ui-bg-card));
}

.inspector-task.is-done {
