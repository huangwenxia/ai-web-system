  // <StepPills :steps separator>
  // steps: [{ label, state: 'done'|'doneGreen'|'current'|'todo' }]
  // 鐎甸偊鍣ｉ弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊骞愰崶鈹夸粵闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� stepper闂佽法鍠愰弸濠氬箯?
  // v3.8
  StepPills: {
