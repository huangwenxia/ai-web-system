  // <ProgressBar value max state height>
  // 闂佽法鍠愰弸濠氬箯闁垮鍋撴笟鈧弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊宕㈤悢鍏兼櫢闁规亽鍎荤紞鍥箯缁屽〗to: 闂佽法鍠愰弸濠氬箯?0% warning, 闂佽法鍠愰弸濠氬箯?00% danger闂佽法鍠愰弸濠氬箯?
  // 闂佽法鍠愰弸濠氬箯?UsageBar 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氱瓎rogressBar 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枔濞堟洟顢橀妸锕€顏舵俊顖炰憾閺佹挾寰婄€圭饱geBar = 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?+ 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鎯板闁规彃顑嗙€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫锟�?
  // v3.8
  ProgressBar: {
    props: {
      value:  { type: Number, required: true },
      max:    { type: Number, default: 100 },
      state:  { type: String, default: 'auto' },
      height: { type: Number, default: 6 },
    },
    computed: {
      percent() { return Math.min(100, this.max ? (this.value / this.max) * 100 : 0); },
      autoState() {
        if (this.state !== 'auto') return this.state;
        if (this.percent >= 100) return 'danger';
        if (this.percent >= 80)  return 'warning';
        return 'normal';
      },
    },
    template: `
      <div class="progress-bar" :style="{ height: height + 'px' }" data-component="progress-bar">
        <div class="progress-bar__fill"
             :class="'progress-bar__fill--' + autoState"
             :style="{ width: percent + '%' }"></div>
      </div>
    `
  },

  // <DataTable :data :columns :total :page :pageSize loading emptyText showPagination operationsLabel operationsWidth>
  // columns: [{ label, prop, width?, minWidth?, fixed?, align?, sortable?, slot? }]
  // slot per column via slot 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?columns 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?slot 闂佽法鍠曢、婊冣枔绾板绉堕柟锟�?
  // slot:operations 闂佽法鍠撳▓鏇犳媼鐟欏嫬顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌ㄩ悢绋跨枂閻犲泧鍕伓婵炵⒈鍙冮弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氬綊鏌�?
  // v-model:page 闁告瑥鐭傞弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑瑜邦喚绮电憴鍕伓闂侊拷?
  // v3.7
  DataTable: {
    props: {
      data:            { type: Array,   default: () => [] },
      columns:         { type: Array,   required: true },
      total:           { type: Number,  default: 0 },
      page:            { type: Number,  default: 1 },
      pageSize:        { type: Number,  default: 10 },
      loading:         { type: Boolean, default: false },
      emptyText:       { type: String,  default: '闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� / No data' },
      showPagination:  { type: Boolean, default: true },
      operationsLabel: { type: String,  default: '闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷' },
      operationsWidth: { type: [String, Number], default: 160 },
    },
    emits: ['update:page', 'update:pageSize', 'row-click'],
    template: `
      <div class="data-table" data-component="data-table">
        <el-table
          v-loading="loading"
          :data="data"
          :empty-text="emptyText"
          style="width:100%;"
          @row-click="(row) => $emit('row-click', row)"
        >
          <el-table-column
            v-for="col in columns"
            :key="col.key || col.prop || col.label"
            :prop="col.prop"
            :label="col.label"
            :width="col.width"
            :min-width="col.minWidth"
            :fixed="col.fixed"
            :align="col.align || 'left'"
            :sortable="col.sortable"
          >
            <template #default="scope" v-if="col.slot">
              <slot :name="col.slot" :row="scope.row" :col="col" :index="scope.$index"></slot>
            </template>
          </el-table-column>
          <el-table-column
            v-if="$slots.operations"
            :label="operationsLabel"
            :width="operationsWidth"
            fixed="right"
          >
            <template #default="scope">
              <slot name="operations" :row="scope.row" :index="scope.$index"></slot>
            </template>
          </el-table-column>
        </el-table>
        <div v-if="showPagination && total > 0" class="data-table__pagination">
          <el-pagination
            :current-page="page"
            :page-size="pageSize"
            :total="total"
            layout="total, prev, pager, next"
            :pager-count="5"
            background
            @current-change="(p) => $emit('update:page', p)"
            @size-change="(s) => $emit('update:pageSize', s)"
          ></el-pagination>
        </div>
      </div>
    `
  },

  // <Tag color preset icon> + slot:default 闂佽法鍠愰弸濠氬箯?闂侇偅宀搁弫鎾绘儗椤愶絽鏁鹃柟鐑筋棑椤掔兘鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕柣妯垮煐閳ь兛绶氶弫鎾诲棘閵堝棗顏�
  // color: purple|blue|green|orange|yellow|muted|red
  // preset: trending|new|beta|stable|deprecated闂佽法鍠愰弸濠氬箯缁嬬けg 闂佽法鍠撶划鍛婂濞嗘劕顏堕梺璺ㄥ枑閺嬪骞�?
  //       | conversation|multi-modal|reasoning|embedding|image闂佽法鍠愰弸濠氬箯闁垮瑔渚€鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕梺璺ㄥ枛閸欐椽鏁愯箛鏂款伓
  // v3.6
  Tag: {
    props: {
      color:  { type: String, default: 'muted' },
      preset: { type: String, default: '' },
      icon:   { type: String, default: '' },
    },
    computed: {
      finalColor() {
        const map = {
          // Tag 闂佽法鍠撶划鍛婂濞嗘劕顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氾拷2.3闂佽法鍠愰弸濠氬箯?
          trending: 'purple', new: 'green', beta: 'blue', stable: 'muted', deprecated: 'muted',
          // 婵☆垽绻濋弫鎾诲棘閵堝棗顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氾拷 Badge闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷2.3闂佽法鍠愰弸濠氬箯?
          conversation: 'blue', 'multi-modal': 'purple', reasoning: 'orange', embedding: 'yellow', image: 'green',
        };
        return this.preset ? (map[this.preset.toLowerCase()] || this.color) : this.color;
      },
      finalIcon() {
        if (this.preset === 'deprecated') return 'triangle-alert';
        return this.icon;
      },
      finalLabel() {
        const labelMap = { 'multi-modal': 'Multi-Modal' };
        if (labelMap[this.preset]) return labelMap[this.preset];
        if (!this.preset) return '';
        return this.preset.charAt(0).toUpperCase() + this.preset.slice(1);
      }
    },
    template: `
      <span class="tag" :class="'badge-' + finalColor" data-component="tag">
        <i v-if="finalIcon" :data-lucide="finalIcon"></i>
        <slot>{{ finalLabel }}</slot>
      </span>
    `
  },

  // <CardBox title> + slot:headerRight + default 闂佽法鍠愰弸濠氬箯?闂侇偅宀搁弫鎾绘儗椤愩垹鐨￠柟鐑筋棑婢ф牠鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏�
  // v3.6
  CardBox: {
    props: {
      title:  { type: String, default: '' },
      padded: { type: Boolean, default: false },
    },
    template: `
      <div class="card-box" :class="{ 'card-box--padded': padded }" data-component="card-box">
        <div v-if="title || $slots.headerRight" class="card-box__head">
          <div class="card-box__title">{{ title }}</div>
          <div v-if="$slots.headerRight" class="card-box__head-right">
            <slot name="headerRight"></slot>
          </div>
        </div>
        <div class="card-box__body"><slot></slot></div>
      </div>
    `
  },

  // <Tabs :options v-model variant> 闂佽法鍠愰弸濠氬箯?闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 Tabs闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁癸拷?DetailPage闂佽法鍠愰弸濠氬箯?
  // variant: underline (濮掓稒锕㈤弫鎾诲棘閵堝棗顏�) | segmented
  // options: [{ label, value, count? }]
  // v3.6
  Tabs: {
    props: {
      options:    { type: Array, required: true },
      modelValue: { type: [String, Number], default: '' },
      variant:    { type: String, default: 'underline' },
    },
    emits: ['update:modelValue'],
    template: `
      <div v-if="variant === 'segmented'" class="tabs-segmented" data-component="tabs">
        <button
          v-for="opt in options" :key="opt.value"
          type="button"
          class="tabs-segmented__item"
          :class="{ 'is-active': modelValue === opt.value }"
          @click="$emit('update:modelValue', opt.value)"
        >
          {{ opt.label }}
          <span v-if="opt.count != null" class="tabs-segmented__count">{{ opt.count }}</span>
        </button>
      </div>
      <div v-else class="detail-tabs" data-component="tabs">
        <button
          v-for="opt in options" :key="opt.value"
          type="button"
          class="detail-tabs__item"
          :class="{ 'is-active': modelValue === opt.value }"
          @click="$emit('update:modelValue', opt.value)"
        >
          {{ opt.label }}
          <span v-if="opt.count != null" style="margin-left:6px;color:var(--ui-text-muted);font-weight:400;">({{ opt.count }})</span>
        </button>
      </div>
    `
  },

  // <Avatar src name size color> 闂佽法鍠愰弸濠氬箯?闂佽法鍠撻悡顐ｅ濞嗘劕顏跺鑸垫尦閺佹捇寮妶鍡楊伓letter fallback + 闂佽法鍠撳▓鏇犳媼鐟欏嫬顏堕梺璺ㄥ枑閺嬪骞忛悿顖氼棌闂佽法鍠愰弸濠氬箯?
  // size: small|default|large
  // v3.6
  Avatar: {
    props: {
      src:   { type: String, default: '' },
      name:  { type: String, default: '' },
      size:  { type: String, default: 'default' },
      color: { type: String, default: '' }, // 闂佽法鍠撳▓鏇犳媼鐟欏嫬顏堕梺璺ㄥ枙濡嫰鎳楀畝鍕櫢闁哄倶鍊栫€氬綊鎳�?
    },
    computed: {
      initials() {
        if (!this.name) return '?';
        const parts = this.name.trim().split(/\s+/);
        if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        return this.name.substring(0, 2).toUpperCase();
      },
      sizeClass() { return 'avatar-' + this.size; },
      autoBg() {
        if (this.color) return this.color;
        if (!this.name) return 'var(--ui-bg-muted)';
        const palette = [
          'var(--ui-badge-purple-bg)',
          'var(--ui-badge-blue-bg)',
          'var(--ui-badge-green-bg)',
          'var(--ui-badge-orange-bg)',
          'var(--ui-badge-yellow-bg)',
        ];
        const hash = [...this.name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
        return palette[hash % palette.length];
      },
      autoFg() {
        if (this.color) return 'var(--ui-text-on-brand)';
        if (!this.name) return 'var(--ui-text-muted)';
        const palette = [
          'var(--ui-badge-purple-fg)',
          'var(--ui-badge-blue-fg)',
          'var(--ui-badge-green-fg)',
          'var(--ui-badge-orange-fg)',
          'var(--ui-badge-yellow-fg)',
        ];
        const hash = [...this.name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
        return palette[hash % palette.length];
      },
    },
    template: `
      <div class="avatar" :class="sizeClass" data-component="avatar"
           :style="{ background: autoBg, color: autoFg }">
        <img v-if="src" :src="src" :alt="name" />
        <span v-else>{{ initials }}</span>
      </div>
    `
  },

  // <BalanceBox :info :lang> 闂佽法鍠愰弸濠氬箯?TopNav 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柟娲诲幐閺咁亪骞忔搴㈠晳妞ゎ厽甯楃€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫锟�?project-mamba BalanceBox.vue闂佽法鍠愰弸濠氬箯?
  // info: { balance: Number, level: 'normal'|'low'|'critical'|'empty', currency: 'Credits', showTopUp: Boolean, topUpLabel?: String, runwayDays?: Number }
