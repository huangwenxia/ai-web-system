            <div v-if="eyebrow" class="page-header__eyebrow">
              <span v-if="!eyebrowIcon" class="page-header__eyebrow-dot"></span>
              <i v-else :data-lucide="eyebrowIcon"></i>
              <span>{{ eyebrow }}</span>
            </div>
            <div class="page-header__title-row">
              <slot name="avatar"></slot>
              <h1 class="page-header__title">{{ title }}</h1>
              <span v-if="statusLabel" :class="['page-header__status-pill', 'page-header__status-pill--' + statusColor]">{{ statusLabel }}</span>
            </div>
            <p v-if="subtitle" class="page-header__subtitle">{{ subtitle }}</p>
          </div>
          <div v-if="$slots.actions" class="page-header__right">
            <slot name="actions"></slot>
          </div>
        </div>
      </div>
    `
  },

  // <MetricsStrip :items cols divided>
  // items: [{ label, value, sub?, accent?, slot?, key? }]
  // 闂佽法鍠栭妶娲礄閵堝棗顏堕柟绋挎喘閺佹捇寮妶鍡楊伓闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氱ero 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氾拷 / Overview 闂佽法鍠愰崺鍛村箟鐎ｎ偄顏堕梺璺ㄥ枑閺嬪骞忛悜鑺ユ櫢闁哄倶鍊栫€氱ols 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊寮崼鏇熸櫢闁哄倶鍊栫€氾拷 items.length 闂佽法鍠撳▓鏇犳媼鐟欏嫬顏堕梺璺ㄥ枛閵堟椽宕欓妶鍡楊伓
  // v3.8
  MetricsStrip: {
    props: {
      items:   { type: Array,   required: true },
      cols:    { type: Number,  default: 0 },
      divided: { type: Boolean, default: true },
    },
    template: `
      <div
        class="metrics-strip"
        :class="{ 'metrics-strip--divided': divided }"
        :style="{ gridTemplateColumns: 'repeat(' + (cols || items.length) + ', minmax(0, 1fr))' }"
        data-component="metrics-strip"
      >
        <div v-for="(item, i) in items" :key="item.key || i" class="metrics-strip__cell">
          <div class="metrics-strip__label">{{ item.label }}</div>
          <div class="metrics-strip__value" :class="{ 'metrics-strip__value--accent': item.accent }">
            <slot v-if="item.slot" :name="item.slot" :item="item">{{ item.value }}</slot>
            <template v-else>{{ item.value }}</template>
          </div>
          <div v-if="item.sub" class="metrics-strip__sub">{{ item.sub }}</div>
        </div>
      </div>
    `
  },

  // <HeroBand eyebrow eyebrowIcon title desc :points tone> + slot:right
  // Overview 闂佽法鍠愰弸濠氬箯閻戣姤鏅搁柡鍌樺€栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏堕柦鈧妷鈺傛櫢闁哄倶鍊栫€氬綊鏌ㄩ悢鍛婄伄闁归鍏橀弫鎾诲棘閵堝棗顏� + 闂佽法鍠愯ぐ顔炬嫚瑜庣€氾拷 CTA/闂侇偄顦甸弫鎾诲棘閵堝棗顏�
  // tone: primary | neutral | gradient
  // v3.8
  HeroBand: {
    props: {
      eyebrow:     { type: String, default: '' },
      eyebrowIcon: { type: String, default: '' },
      title:       { type: String, required: true },
      desc:        { type: String, default: '' },
      points:      { type: Array,  default: () => [] }, // [{icon, title, desc}]
      tone:        { type: String, default: 'primary' },
    },
    template: `
      <div class="hero-band" :class="['hero-band--' + tone, { 'hero-band--with-right': !!$slots.right }]" data-component="hero-band">
        <div class="hero-band__left">
          <div v-if="eyebrow" class="hero-band__eyebrow">
            <i v-if="eyebrowIcon" :data-lucide="eyebrowIcon"></i>
            <span>{{ eyebrow }}</span>
          </div>
          <h1 class="hero-band__title">{{ title }}</h1>
          <p v-if="desc" class="hero-band__desc">{{ desc }}</p>
          <div v-if="points.length" class="hero-band__points">
            <div v-for="(p, i) in points" :key="i" class="hero-band__point">
              <i v-if="p.icon" :data-lucide="p.icon"></i>
              <div>
                <strong v-if="p.title">{{ p.title }}</strong>
                <span v-if="p.desc">{{ p.desc }}</span>
              </div>
            </div>
          </div>
        </div>
        <div v-if="$slots.right" class="hero-band__right">
          <slot name="right"></slot>
        </div>
      </div>
    `
