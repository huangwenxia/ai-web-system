  }

  .deploy-empty-board {
    min-height: min(460px, 58vh);
    padding: var(--ui-space-2xl) var(--ui-space-lg);
  }

  .record-empty-state.is-scope-empty {
    min-height: 156px;
  }
}

@media (max-width: 48rem) {
  .detail-head-row {
