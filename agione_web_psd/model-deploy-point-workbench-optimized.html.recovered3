        { code: 'ko', label: '???',  required: false },
      ]},
      required:    { type: Array,   default: () => [] }, // 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 langs 闂備浇娉曢崰搴ゃ亹閵娧冩瀳濠㈣泛顑呴锟� required 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺咃拷?
      placeholder: { type: [String, Object], default: '' }, // 闂備浇娉曢崰鏇€€佸⿰鍫濈闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘炬嫹 { zh: '...', en: '...' }
    },
    emits: ['update:modelValue'],
    data() {
      return { activeTab: this.langs[0]?.code || 'zh' };
    },
    computed: {
      effectiveRequired() {
        return this.required.length > 0 ? this.required : this.langs.filter(l => l.required).map(l => l.code);
      },
      currentPlaceholder() {
        if (typeof this.placeholder === 'string') return this.placeholder;
        return this.placeholder[this.activeTab] || '';
      },
    },
    methods: {
      isRequired(code) { return this.effectiveRequired.includes(code); },
      isFilled(code)   { return ((this.modelValue || {})[code] || '').trim().length > 0; },
      dotClass(code) {
        if (this.isFilled(code))   return 'i18n-status-dot--done';
        if (this.isRequired(code)) return 'i18n-status-dot--required';
        return 'i18n-status-dot--missing';
      },
      updateValue(val) {
        this.$emit('update:modelValue', { ...(this.modelValue || {}), [this.activeTab]: val });
      },
    },
    template: `
      <div class="i18n-field" data-component="i18n-field">
        <div class="i18n-field__tabs" role="tablist">
          <button
            v-for="l in langs"
            :key="l.code"
            class="i18n-field__tab"
            :class="{ 'is-active': activeTab === l.code }"
            @click="activeTab = l.code"
            role="tab"
            type="button"
          >
            <span class="i18n-field__tab-name">{{ l.label }}</span>
            <span v-if="isRequired(l.code)" class="i18n-field__tab-required">*</span>
            <span class="i18n-status-dot" :class="dotClass(l.code)"></span>
          </button>
        </div>
        <el-input
          :model-value="(modelValue || {})[activeTab] || ''"
          @update:model-value="updateValue"
          :placeholder="currentPlaceholder"
          size="large"
        ></el-input>
      </div>
    `
  },

};

