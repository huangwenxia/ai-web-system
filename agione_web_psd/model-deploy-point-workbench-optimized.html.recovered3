  // v3.8
  MetricsStrip: {
    props: {
      items:   { type: Array,   required: true },
      cols:    { type: Number,  default: 0 },
      divided: { type: Boolean, default: true },
    },
    template: `
      <div
        class="metrics-strip"
        :class="{ 'metrics-strip--divided': divided }"
        :style="{ gridTemplateColumns: 'repeat(' + (cols || items.length) + ', minmax(0, 1fr))' }"
        data-component="metrics-strip"
      >
        <div v-for="(item, i) in items" :key="item.key || i" class="metrics-strip__cell">
          <div class="metrics-strip__label">{{ item.label }}</div>
          <div class="metrics-strip__value" :class="{ 'metrics-strip__value--accent': item.accent }">
            <slot v-if="item.slot" :name="item.slot" :item="item">{{ item.value }}</slot>
            <template v-else>{{ item.value }}</template>
          </div>
          <div v-if="item.sub" class="metrics-strip__sub">{{ item.sub }}</div>
        </div>
      </div>
    `
  },

