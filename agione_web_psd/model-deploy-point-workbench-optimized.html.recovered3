    function filledApiRows(rows) {
      return (rows || []).filter((row) => row?.key && row?.name && row?.value !== undefined && row?.value !== '' && row?.type);
    }

    function hasOutputConfig(point) {
      const config = point?.apiConfig;
      return Boolean(
        config?.apiEndpointUrl &&
        config?.method &&
        filledApiRows(config?.requestHeaders).length &&
        filledApiRows(config?.requestParameters).length
      );
    }

    function isPointComplete(point) {
      return hasModel(point) && hasDeployConfig(point) && hasOutputConfig(point);
    }

    function pointStatusText(point) {
      if (isPointComplete(point)) return '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅锟�';
      if (!hasModel(point) && !hasDeployConfig(point) && !hasOutputConfig(point)) return '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?;
      if (!hasModel(point)) return '缂傚倸鍊瑰浠嬪极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙煥鐎ｅ棔绶氶弻銊╂偄閸涘﹦浼勯梺鐧告嫹?;
      if (!hasDeployConfig(point)) return '缂傚倸鍊瑰浠嬪极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?;
      if (!hasOutputConfig(point)) return '缂傚倸鍊瑰浠嬪极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺閺岋拷?;
      return '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?;
    }

    function pointStatusClass(point) {
      if (isPointComplete(point)) return 'badge-green';
      if (hasModel(point) || hasDeployConfig(point) || hasOutputConfig(point)) return 'badge-purple';
      return 'badge-orange';
    }

    const incompleteDeployPointCount = computed(() => deployPoints.filter((point) => !isPointComplete(point)).length);
    const deployPointSummary = computed(() => {
      const total = deployPoints.length;
      if (!total) return '闂備浇娉曢崰鎰板几婵犳艾绠梺鍨儑濮婇箖姊虹捄銊ユ瀻鐟滆埇鍔庨幏鐘侯槼閻庢艾缍婇弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮敓锟�?;
      return incompleteDeployPointCount.value
        ? `${total} 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮敓锟�?闂備浇娉曢崰鎰板几婵犳艾绠�?${incompleteDeployPointCount.value} 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅绂�
        : `${total} 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮敓锟�?闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭婢樺鍧楁⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻敃锟�;
    });
    const isStepDeployEmpty = computed(() => activeScenario.value === 'empty' || !deployPoints.length);
    const canGoNextMainStep = computed(() => !(currentMainStep.value === 2 && (isStepDeployEmpty.value || incompleteDeployPointCount.value > 0)));

    function syncPointScenario(point) {
      if (!point) return;
      if (isPointComplete(point)) point.scenario = 'done';
      else if (hasDeployConfig(point) || hasOutputConfig(point)) point.scenario = 'deploy';
      else if (hasModel(point)) point.scenario = 'deploy';
      else point.scenario = 'intake';
    }

    function selectDeployPoint(point) {
      activePointId.value = point.id;
      activeScenario.value = point.scenario;
      downloadCommandExpanded.value = false;
      nextTick(() => lucide.createIcons());
    }

    function selectScenario(key) {
      if (key === 'empty') {
        activeScenario.value = 'empty';
        nextTick(() => lucide.createIcons());
        return;
      }
      const scenarioPoint = deployPoints.find((point) => point.scenario === key);
      if (scenarioPoint) selectDeployPoint(scenarioPoint);
      else activeScenario.value = key;
      nextTick(() => lucide.createIcons());
    }

    function comboForLocation(cloudName, regionName) {
      const location = locationOptions.find((item) => item.cloudName === cloudName && item.regionName === regionName);
      return location?.combo || `${cloudName} / ${regionName}`;
    }

    function firstAvailableLocation(source = locationOptions) {
      return source.find((location) =>
        !deployPoints.some((point) => point.cloudName === location.cloudName && point.regionName === location.regionName)
      ) || source[0];
    }

    function applyLocationToForm(location) {
      intakeForm.cloudType = location.cloudType;
      intakeForm.cloudName = location.cloudName;
      intakeForm.regionName = location.regionName;
      intakeForm.source = sourceValueForPoint(location);
    }

    function selectFirstFilteredLocation() {
      const location = firstAvailableLocation(filteredLocationOptions.value);
      selectedLocationCombo.value = location?.combo || '';
      if (location) applyLocationToForm(location);
    }

    function resetLocationFilters() {
      if (locationCloudFilter.value === 'all' && locationRegionFilter.value === 'all') return;
      locationCloudFilter.value = 'all';
      locationRegionFilter.value = 'all';
      selectFirstFilteredLocation();
      nextTick(() => lucide.createIcons());
    }

    function selectLocationOption(location) {
      if (!location || location.added) return;
      selectedLocationCombo.value = location.combo;
      applyLocationToForm(location);
      nextTick(() => lucide.createIcons());
    }

    function switchToLocationPoint(location) {
      if (!location?.point) return;
      selectDeployPoint(location.point);
      intakeDialogVisible.value = false;
    }

    function noop() {}

    function removeDeployPoint(point) {
      const index = deployPoints.findIndex((item) => item.id === point?.id);
      if (index < 0) return;
      const wasActive = activePointId.value === point.id;
      deployPoints.splice(index, 1);

      if (!deployPoints.length) {
        activePointId.value = '';
        activeScenario.value = 'empty';
        nextTick(() => lucide.createIcons());
        return;
      }

      if (wasActive) {
        const nextPoint = deployPoints[Math.min(index, deployPoints.length - 1)];
        selectDeployPoint(nextPoint);
        return;
      }

      nextTick(() => lucide.createIcons());
    }

    function startBlankDeploymentPoint() {
      openIntakeDialog('add');
    }

    function openIntakeDialog(mode = 'add', point = activePoint.value) {
      intakeDialogMode.value = mode;
      intakeDialogTargetId.value = mode === 'edit' && point ? point.id : '';

      if (mode === 'edit' && point) {
        const policy = sourcePolicyForPoint(point);
        const source = policy.noSource
          ? null
          : normalizeSourceForPoint(point, point.source || sourceValueForPoint(point));
        intakeForm.cloudType = cloudTypeOfPoint(point);
        intakeForm.cloudName = point.cloudName;
        intakeForm.regionName = point.regionName;
        intakeForm.source = source;
        intakeForm.cloudAccountName = point.cloudAccountName || '';
        intakeForm.publicModelName = point.publicModelName || '';
        intakeForm.accessToken = point.accessToken || '';
        intakeForm.downloadCommand = point.downloadCommand || '';
        intakeForm.path = point.path || '';
        if (isPublicModelSource(source)) setPublicModelDefaults(point);
      } else {
        locationCloudFilter.value = 'all';
        locationRegionFilter.value = 'all';
        selectFirstFilteredLocation();
        intakeForm.cloudAccountName = '';
        intakeForm.publicModelName = '';
        intakeForm.accessToken = '';
        intakeForm.downloadCommand = '';
        intakeForm.path = '';
      }

      intakeDialogVisible.value = true;
      nextTick(() => lucide.createIcons());
    }

    function saveIntakeDialog() {
      const isEdit = Boolean(intakeDialogTargetId.value);
      if (!isEdit) {
        const location = selectedLocationOption.value;
        if (!location) return;
        if (location.added) {
          switchToLocationPoint(location);
          return;
        }

        const point = {
          id: `deploy-${Date.now()}`,
          cloudType: location.cloudType,
          cloudName: location.cloudName,
          regionName: location.regionName,
          combo: location.combo,
          scenario: 'intake',
          source: '',
          modelSource: '',
          accessToken: '',
          downloadCommand: '',
          publicModelName: '',
          cloudAccountName: '',
          path: '',
          frameworks: [],
          specs: [],
          apiConfig: null,
        };
        deployPoints.unshift(point);
        syncPointScenario(point);
        activePointId.value = point.id;
        activeScenario.value = 'intake';
        downloadCommandExpanded.value = false;
        intakeDialogVisible.value = false;
        nextTick(() => lucide.createIcons());
        return;
      }

      const point = deployPoints.find((item) => item.id === intakeDialogTargetId.value);
      if (!point) return;
      const policy = sourcePolicyForPoint(point);
      const source = policy.noSource
        ? null
        : normalizeSourceForPoint(point, intakeForm.source || sourceValueForPoint(point));
      point.source = source;
      point.modelSource = source ? sourceLabel(source) : policy.policyLabel;

      if (policy.noSource) {
        point.accessToken = '';
        point.downloadCommand = '';
        point.publicModelName = '';
        point.cloudAccountName = '';
        point.path = '';
      } else if (isExternalModelSource(source)) {
        point.accessToken = intakeForm.accessToken;
        point.downloadCommand = intakeForm.downloadCommand;
        point.publicModelName = '';
        point.cloudAccountName = '';
        point.path = '';
      } else if (isPublicModelSource(source)) {
        setPublicModelDefaults(point);
        point.cloudAccountName = intakeForm.cloudAccountName;
        point.publicModelName = intakeForm.publicModelName;
        point.accessToken = '';
        point.downloadCommand = '';
        point.path = '';
      } else {
        point.path = intakeForm.path;
        point.accessToken = '';
        point.downloadCommand = '';
        point.publicModelName = '';
        point.cloudAccountName = '';
      }

      syncPointScenario(point);
      activePointId.value = point.id;
      activeScenario.value = point.scenario;
      intakeDialogVisible.value = false;
      nextTick(() => lucide.createIcons());
    }

    function setDeploymentStage(stage) {
      activeScenario.value = stage;
      nextTick(() => lucide.createIcons());
    }

    function openConfigDialog() {
      configDialogVisible.value = true;
      nextTick(() => lucide.createIcons());
    }

    function saveConfigDialog() {
      const point = activePoint.value;
      const template = resourceTemplateForPoint(point);
      point.frameworks.splice(0, point.frameworks.length, { ...template.framework, region: point.regionName });
      point.specs.splice(0, point.specs.length, { ...template.spec, region: point.regionName });
      syncPointScenario(point);
      activeScenario.value = point.scenario;
      configDialogVisible.value = false;
      nextTick(() => lucide.createIcons());
    }

    function cloneApiRows(rows = []) {
      return rows.map((row) => ({
        key: row?.key || '',
        name: row?.name || '',
        value: row?.value ?? '',
        type: row?.type || 'string',
        required: Boolean(row?.required),
      }));
    }

    function assignApiForm(config) {
      const fallback = createDefaultApiConfig(activePoint.value, activePoint.value?.publicModelName || '{model}');
      const nextConfig = config || fallback;
      apiForm.apiEndpointUrl = nextConfig.apiEndpointUrl || fallback.apiEndpointUrl;
      apiForm.method = nextConfig.method || fallback.method;
      apiForm.requestHeaders.splice(0, apiForm.requestHeaders.length, ...cloneApiRows(nextConfig.requestHeaders?.length ? nextConfig.requestHeaders : fallback.requestHeaders));
      apiForm.requestParameters.splice(0, apiForm.requestParameters.length, ...cloneApiRows(nextConfig.requestParameters?.length ? nextConfig.requestParameters : fallback.requestParameters));
      apiForm.codeSamples.curlExtra = nextConfig.codeSamples?.curlExtra ?? fallback.codeSamples.curlExtra;
    }

    function openApiDialog() {
      assignApiForm(activePoint.value?.apiConfig);
      apiDialogVisible.value = true;
      nextTick(() => lucide.createIcons());
    }

    function saveApiDialog() {
      const point = activePoint.value;
      point.apiConfig = {
        apiEndpointUrl: apiForm.apiEndpointUrl,
        method: apiForm.method,
        requestHeaders: cloneApiRows(apiForm.requestHeaders),
        requestParameters: cloneApiRows(apiForm.requestParameters),
        codeSamples: {
          curlExtra: apiForm.codeSamples?.curlExtra || '',
        },
      };
      syncPointScenario(point);
      activeScenario.value = point.scenario;
      apiDialogVisible.value = false;
      nextTick(() => lucide.createIcons());
    }

    function addApiRow(target) {
      apiForm[target].push({ key: '', name: '', value: '', type: 'string', required: false });
      nextTick(() => lucide.createIcons());
    }

    function removeApiRow(target, index) {
      apiForm[target].splice(index, 1);
      nextTick(() => lucide.createIcons());
    }

    function apiRequiredText(row) {
      return row?.required ? '闂備浇娉曢崰鎰板几婵犳艾绠�? : '闂備浇娉曢崰鎰板几婵犳艾绠�?;
    }

    function parseApiParamValue(row) {
      const type = String(row?.type || '').toLowerCase();
      const value = row?.value;
      if (type === 'object') {
        try {
          return typeof value === 'string' ? JSON.parse(value) : value || {};
        } catch (error) {
          return value || {};
        }
      }
      if (type === 'number') {
        const numeric = Number(value);
        return Number.isNaN(numeric) ? value : numeric;
      }
      if (type === 'boolean') {
        if (typeof value === 'boolean') return value;
        return String(value).trim().toLowerCase() === 'true';
      }
      return value;
    }

    function apiRequestData(rows = []) {
      return filledApiRows(rows).reduce((data, row) => {
        data[row.key] = parseApiParamValue(row);
        return data;
      }, {});
    }

    function apiHeadersData(rows = []) {
      return filledApiRows(rows).reduce((headers, row) => {
        headers[row.key] = row.value;
        return headers;
      }, {});
    }

    function apiPreviewCurl(config = apiForm, point = activePoint.value) {
      const headers = apiHeadersData(config.requestHeaders);
      const requestData = apiRequestData(config.requestParameters);
      const headerLines = Object.entries(headers).map(([key, value]) => `    -H "${key}: ${value}"`);
      const curlExtra = cloudTypeOfPoint(point) === 'aws' ? (config.codeSamples?.curlExtra || '') : '';
      return [
        `curl -X ${config.method || 'POST'} "${config.apiEndpointUrl || '{request_url}'}"`,
        curlExtra,
        ...headerLines,
        `  -d '${JSON.stringify(requestData)}'`,
      ].filter(Boolean).join(' \\\n');
    }

    function stageState(stage) {
      if (stage === 'model') {
        return hasModel(activePoint.value) ? 'done' : 'pending';
      }
      if (stage === 'deploy') {
        return hasDeployConfig(activePoint.value) ? 'done' : 'pending';
      }
      return hasOutputConfig(activePoint.value) ? 'done' : 'pending';
    }

    function stageClass(stage) {
      const state = stageState(stage);
      return { 'is-current': state === 'current', 'is-done': state === 'done' };
    }

    function stageBadge(stage) {
      const state = stageState(stage);
      if (state === 'done') return '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺咃拷?;
      return '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?;
    }

    function resourceCount(items) {
      return items?.length ? `${items.length} 闂備浇娉曢崰鎰板几婵犳艾绠紒宀嬫嫹 : '0 闂備浇娉曢崰鎰板几婵犳艾绠�?;
    }

    function mainStepClass(step) {
      return {
        'is-done': step.id < currentMainStep.value,
        'is-current': step.id === currentMainStep.value,
      };
    }

    function goPreviousMainStep() {
      currentMainStep.value = Math.max(1, currentMainStep.value - 1);
      nextTick(() => lucide.createIcons());
    }

    function goNextMainStep() {
      if (currentMainStep.value === 2 && isStepDeployEmpty.value) return;
      currentMainStep.value = Math.min(mainSteps.length, currentMainStep.value + 1);
      nextTick(() => lucide.createIcons());
    }

    function advanceActivePoint() {
      if (activeScenario.value === 'empty') openIntakeDialog('add');
      else if (!hasModel(activePoint.value)) openIntakeDialog('edit', activePoint.value);
      else if (!hasDeployConfig(activePoint.value)) openConfigDialog();
      else openApiDialog();
    }

    function toggleTheme() {
      isDark.value = !isDark.value;
      const vars = isDark.value ? darkVars : lightVars;
      Object.entries(vars).forEach(([k, v]) =>
        document.documentElement.style.setProperty(k, v)
      );
      nextTick(() => lucide.createIcons());
    }

    function toggleLang() {
      lang.value = lang.value === 'en' ? 'zh' : 'en';
      nextTick(() => lucide.createIcons());
    }

    // 闂備浇娉曢崰鏇熺箾閸ヮ剚鍋栭悗娑櫭锟� activeNav 闂備浇娉曢崰搴ゃ亹閵婏箑顕辨繛鍡樺姇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺懓鍢查崲鎻捗瑰鈧弻銊╂偄閻戞ḿ浼囬梺鎸庣☉閻楁捇寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂備胶鍋撴竟鍡涱敆閺屻儱绠柣鎴ｅГ閺呮悂鎮跺☉娆樻畼妞わ綆鍣ｉ獮锟�?v-show 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺瀹曡埖銈ｉ崘鈺傛闂佹眹鍊戦崕鎵箔婢舵劖鐓ラ柣鏂挎啞閻忣噣鏌熼悜鑺ユ暠闁绘挸顑夐弻銊╂偄閸涘﹦浼勯梺鐧告嫹?
    watch(activeNav, () => {
      nextTick(() => lucide.createIcons());
    });
    watch(activeScenario, () => {
      nextTick(() => lucide.createIcons());
    });
    watch(locationCloudFilter, () => {
      if (locationRegionFilter.value !== 'all' && !locationRegionOptions.value.includes(locationRegionFilter.value)) {
        locationRegionFilter.value = 'all';
      }
    });
    watch([locationCloudFilter, locationRegionFilter], () => {
      if (intakeDialogMode.value !== 'add') return;
      selectFirstFilteredLocation();
      nextTick(() => lucide.createIcons());
    });

    // logo: TopNav 闂備浇娉曢崰鎰板几婵犳艾绠柣銈庡灣缁狅拷 dark 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅锟� dark logo闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑閿燂拷?    const logoSrc = computed(() => isDark.value ? LOGO_DARK : LOGO_DARK);
    return {
      isDark, lang, activeTab, activeNav, t, toggleTheme, toggleLang, logoSrc,
