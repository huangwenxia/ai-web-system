  // v3.8
  ProgressBar: {
    props: {
      value:  { type: Number, required: true },
      max:    { type: Number, default: 100 },
      state:  { type: String, default: 'auto' },
      height: { type: Number, default: 6 },
    },
    computed: {
      percent() { return Math.min(100, this.max ? (this.value / this.max) * 100 : 0); },
      autoState() {
        if (this.state !== 'auto') return this.state;
        if (this.percent >= 100) return 'danger';
        if (this.percent >= 80)  return 'warning';
        return 'normal';
      },
    },
    template: `
      <div class="progress-bar" :style="{ height: height + 'px' }" data-component="progress-bar">
        <div class="progress-bar__fill"
             :class="'progress-bar__fill--' + autoState"
             :style="{ width: percent + '%' }"></div>
      </div>
    `
  },

