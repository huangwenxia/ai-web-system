  padding: var(--ui-space-sm) var(--ui-space-md);
  border: 1px solid color-mix(in srgb, var(--ui-color-primary) 20%, var(--ui-border-soft));
  border-radius: var(--ui-radius-lg);
  background: color-mix(in srgb, var(--ui-color-primary) 5%, var(--ui-bg-card));
}

.readonly-source-card__main {
  min-width: 0;
