    const resourceTemplate = resourceTemplateMap.aws;

    function regionCodeForPoint(point) {
      const comboRegion = point?.combo?.split(' / ')?.[1]?.trim();
      return comboRegion || point?.regionId || point?.regionName || 'us-east-1';
    }

    function awsCurlExtraForPoint(point) {
      return [
        `--aws-sigv4 "aws:amz:${regionCodeForPoint(point)}:sagemaker-runtime"`,
        '-u "${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}"',
      ].join(' \\\n  ');
    }

    function createDefaultApiConfig(point = {}, modelName = '{model}') {
      const cloudType = typeof point === 'string' ? point : point?.cloudType;
