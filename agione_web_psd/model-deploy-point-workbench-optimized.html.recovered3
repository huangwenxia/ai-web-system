  --ui-font-mono:    'IBM Plex Mono', 'SFMono-Regular', ui-monospace, monospace;

  /* 闂備浇娉曢崰鎰板几婵犳艾绠梺鍨儐濞咃拷 */
  --ui-duration-fast: 150ms;   /* hover / focus / state */
  --ui-duration-base: 250ms;   /* card hover / tooltip */
  --ui-duration-slow: 400ms;   /* drawer / dialog */
  --ui-ease-out:    cubic-bezier(0.4, 0, 0.2, 1);   /* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 / hover */
  --ui-ease-in:     cubic-bezier(0.4, 0, 1, 1);      /* 闂備浇娉曢崰搴㈢珶濞嗘垹椹抽悷娆忓椤忥拷 / 闂備浇娉曢崰鏇㈩敋閻樿鎹舵繛宸簼閺呮悂鏌￠崒妯衡偓鏍偓姘辩暎3.10闂備浇娉曢崰鎰板几婵犳艾绠�?*/
  --ui-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);  /* 闂備浇娉曢崰搴ゃ亹閵婏箑顕辨繛鍡樺姇椤忥拷 / 闂佸憡鐟ラ惌鍌炲极閹捐妫橀柕鍫濇椤忕3.10闂備浇娉曢崰鎰板几婵犳艾绠�?*/
  --ui-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1); /* 閻庢鍠楀浠嬪极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻…锟�3.10闂備浇娉曢崰鎰板几婵犳艾绠�?*/

  /* Avatar */
  --ui-avatar-bg: #7c3aed;

  /* 闂佺粯枪閸╂牠鍩€椤戞寧绁板鐧告嫹 Subtle */
  --ui-color-success-subtle:      #ecfdf5;
  --ui-color-warning-subtle:      #fef3c7;
  --ui-color-destructive-subtle:  #fef2f2;

  /* Focus ring */
  --ui-ring: #18181b;

  /* Spacing 闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫮澧楀▓锟�?px 闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭婢樺▍娆撴⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?*/
  --ui-space-xs:   4px;    /* 闂佹悶鍎电粻鏍极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺閺屻劑鎮㈠ú缁樻櫗缂佺虎鍙冮弨杈┾偓姘秺瀹曨剚绺芥径瀣adge 闂備浇娉曢崰鏇熶繆椤撶喐缍囬悷娆忓鐎氭洟鏌熼敓锟�?*/
  --ui-space-sm:   8px;    /* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺瀹曟宕橀鑺ユ闂佽鎯屾禍鐐哄Υ鐎ｎ喖绠€瑰嫮澧楅弳顐ｃ亜椤愵偄鏋熼悗姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?gap */
  --ui-space-md:   12px;   /* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘贡閹风娀骞掗幋鐐叉毆闂佸摜鍠愰鏍偂婢舵劕绠柣鎴ｅГ閺呭摜绱掓径鎰氦缂傚秴娲獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€骞愰幎鑺ョ叆闁绘柨鎲￠悘顕€鏌熼敓锟�?gap */
  --ui-space-base: 16px;   /* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻弻澶愭儊閵娾晛宸濋柡鍌涘閺嗩偅銇勯顐㈡灍閻庢艾缍婇弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮幘璇茬煑妞ゆ劑鍊戦埀顒€顑夐獮蹇涙倻閼恒儲娅�?*/
  --ui-space-lg:   20px;   /* 闂備浇娉曢崰鎰板几婵犳艾绠瀣椤ｅ姊虹捄銊ユ灆濠碘槅鍘藉ḿ蹇曟喆閸曨剙鐝梺鐧告嫹?*/
  --ui-space-xl:   24px;   /* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋欏┑鈽嗗幗濞煎繒娑甸崨顖滃春闂侀潧妫旂拋顤玞tion 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺咃拷?*/
  --ui-space-2xl:  32px;   /* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅锟� */
  --ui-space-3xl:  48px;   /* 婵＄偑鍊楅弫濠氬极閹剧粯鍤嶉柕澶嗘杺閳ь剙锕弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮幘鍓佺煋缂佸鐏濈花濠氭煙閿燂拷?*/

  /* Z-index 闂備浇娉曢崰搴綖閺囩姷妫�?*/
  --ui-z-base:     1;
  --ui-z-dropdown: 100;
  --ui-z-sticky:   200;
  --ui-z-fixed:    300;
  --ui-z-overlay:  400;
  --ui-z-modal:    500;
  --ui-z-popover:  600;
  --ui-z-toast:    700;
  --ui-z-tooltip:  800;
  --ui-z-message:  900;

  /* Icon sizes 闂佹悶鍎电粻鏍极閹捐妫橀柕鍫濇椤忓爼鏌涘▎搴ｇ煓闁轰緤鎷�?*/
  --ui-icon-xs:   12px;
  --ui-icon-sm:   14px;
  --ui-icon-md:   16px;
  --ui-icon-lg:   18px;
  --ui-icon-xl:   20px;
  --ui-icon-2xl:  24px;
  --ui-icon-3xl:  32px;

  /* Element Plus 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
  --el-border-radius-base:     6px;
  --el-border-color:           var(--ui-border-default);
  --el-bg-color:               var(--ui-bg-page);
  --el-bg-color-page:          var(--ui-accent);
  --el-bg-color-overlay:       #ffffff;
  --el-text-color-primary:     var(--ui-text-primary);
  --el-text-color-regular:     var(--ui-text-secondary);
  --el-text-color-secondary:   var(--ui-text-muted);
  --el-text-color-placeholder: var(--ui-text-placeholder);
  --el-text-color-disabled:    var(--ui-text-disabled);
  --el-fill-color-blank:       var(--ui-input);
  --el-fill-color-light:       var(--ui-accent);
  --el-fill-color:             #f0f0f0;
  --el-color-primary:          var(--ui-color-primary);
  --el-disabled-bg-color:      var(--ui-bg-muted);
  --el-disabled-border-color:  var(--ui-border-default);
  --el-mask-color:             rgba(255,255,255,0.9);
}

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 Reset 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
a { text-decoration: none; color: inherit; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 Typography Utility (v3.10 L1 閻庢鍠楀浠嬪极閹捐妫橀柕鍫濇椤忥拷) 闂備浇娉曢崰鎰板几婵犳艾绠�?10 闂備浇娉曢崰鎰板几婵犳艾绠�?.type-* class闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘辨嚀椤垽濮€閵堝棙娅㈤梺鍝勫€堕崐鏍偓姘秺瀹曪拷?font-size/weight/line-height 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
/* 闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭澹嗙€癸拷 闂備浇娉曢崰鎰板几婵犳艾绠�?.2 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂姊烘导瀛樻锭闁活亝澹嗛惀顏囶樄闁轰焦鎹囧顒勫Χ閸℃浼撻梻浣芥硶閸犳劙寮告繝姘闁绘垼濮ら弲鍝ョ磽閸屾稒鍎楅柛瀣崌楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺懓鍢查崲鑼椤掑嫭鐓ラ柣鏂挎啞閻忣噣鏌熼悜绛嬫婵犮垺锕㈤垾锕傚箳閹炬剚浼撻梻渚婃嫹?var(--*) token 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘缁樺亼闁宠棄鎳愮粔鍫曟煙閿燂拷?*/
/* v3.12 P3.3闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?.type-display 缂備緡鍨伴…鐑藉极閹捐鐭楁い鎰靛墰缁夊爼鏌熸搴″幋闁轰焦鎹囧顒勫Χ閸℃浼撻梻浣芥硶閸犳劙寮告繝姘?dialog 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?/ KPI 闂備浇娉曢崰鎾翅缚妤ｅ啫绠熼悗锝庡亜椤忥拷 / 闂佽В鍋撻柕澶嗘櫆閺呮悂鏌￠崒妯衡偓鏍偓姘愁潐閵囷拷?hero */
.type-display       { font-family: var(--ui-font-heading); font-size: 40px; font-weight: 800; line-height: 1.15; letter-spacing: -0.5px; }
.type-display-sm    { font-family: var(--ui-font-heading); font-size: 32px; font-weight: 800; line-height: 1.15; letter-spacing: -0.3px; }
.type-h1            { font-family: var(--ui-font-heading); font-size: 30px; font-weight: 800; line-height: 1.2; }
.type-h2            { font-family: var(--ui-font-heading); font-size: 20px; font-weight: 700; line-height: 1.4; }
.type-h3            { font-family: var(--ui-font-body);    font-size: 16px; font-weight: 600; line-height: 1.4; }
.type-body          { font-family: var(--ui-font-body);    font-size: 14px; font-weight: 400; line-height: 1.6; }
.type-body-sm       { font-family: var(--ui-font-body);    font-size: 13px; font-weight: 400; line-height: 1.43; }
.type-caption       { font-family: var(--ui-font-body);    font-size: 12px; font-weight: 500; line-height: 1.33; }
.type-data          { font-family: var(--ui-font-mono);    font-size: 13px; font-weight: 400; line-height: 1.5; font-variant-numeric: tabular-nums; }
.type-table-header  { font-family: var(--ui-font-body);    font-size: 11px; font-weight: 600; line-height: 1.4; letter-spacing: 0.5px; text-transform: uppercase; }
.type-kpi           { font-family: var(--ui-font-mono);    font-size: 28px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }  /* v5.1闂備浇娉曢崰鎰板几婵犳艾绠紒瀣犯I 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈠ú缁樻櫗闂佹寧绻傜换鎴犫偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?.kpi-card__value 闂備浇娉曢崰宥夋嚑鎼达絺鍋撳☉鏍р偓娑㈩敊閹版澘绠柣鎴ｅГ閺呮悂鎮跺☉娆樻畼閻忓繈鍔戦獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘炬嫹 type 闂備浇娉曢崰鎰板几婵犳艾绠瀣叄閸忓洭姊虹捄銊ユ瀾闁哄顭烽獮蹇曠矙閿燂拷3 婵炴垶鎸诲畝鎼佸极閹惧顩峰┑鐘插€搁獮銏ゆ煛閸屾ê鈧牜鈧艾缍婇弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋欐い銏＄矒瀹曪綁顢涢悙缈犳唉闂佸綊顥撻崗姗€寮幘缁樺剹妞ゆ劦鍓涚粔鍫曟煙閿燂拷?*/

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 App Shell 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠�?.1 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
html, body {
  height: 100%;
  background: var(--ui-topnav-bg);
  font-family: var(--ui-font-body);
  -webkit-font-smoothing: antialiased;
}

.app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.body {
  display: flex;
  flex: 1;
  overflow: hidden;
  border-radius: var(--ui-body-radius);
  background: var(--ui-body-bg);
}

.main {
  flex: 1;
  overflow: auto;
  background: var(--ui-body-bg);
}

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 TopBar 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠�?.2 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
.topnav {
  height: var(--ui-topnav-height);
  min-height: var(--ui-topnav-height);
  background: var(--ui-topnav-bg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  gap: 8px;
  z-index: 100;
}
.topnav-left  { display: flex; align-items: center; gap: 12px; min-width: 0; }
.topnav-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.nav-logo {
  height: 28px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.nav-logo img { height: 28px; width: auto; display: block; }

.nav-divider { width: 1px; height: 20px; background: var(--ui-topnav-accent); flex-shrink: 0; }

.nav-tabs { display: flex; align-items: center; gap: 4px; }

.nav-tab {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 13px; font-weight: 600;
  color: var(--ui-topnav-muted);
  white-space: nowrap;
  transition: background var(--ui-duration-fast), color var(--ui-duration-fast);
}
.nav-tab.active { background: var(--ui-topnav-active-bg); color: var(--ui-topnav-active-fg); }
.nav-tab:not(.active):hover { background: rgba(255,255,255,0.06); color: var(--ui-topnav-foreground); }

.nav-search {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 12px;
  border-radius: 6px;
  background: var(--ui-topnav-accent);
  cursor: pointer;
  transition: opacity var(--ui-duration-fast);
}
.nav-search:hover { opacity: 0.8; }
.nav-search [data-lucide] { width: 14px; height: 14px; color: var(--ui-topnav-muted); flex-shrink: 0; }
.nav-search-text { font-size: 13px; color: var(--ui-topnav-muted); }
.nav-search-kbd {
  padding: 2px 6px; border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.1);
  font-size: 11px; color: var(--ui-topnav-muted);
}

.nav-icon-btn {
  width: 30px; height: 30px;
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  color: var(--ui-topnav-muted);
  transition: background var(--ui-duration-fast), color var(--ui-duration-fast);
  flex-shrink: 0;
}
.nav-icon-btn:hover { background: var(--ui-topnav-accent); color: var(--ui-topnav-foreground); }
.nav-icon-btn [data-lucide] { width: 16px; height: 16px; }

.nav-avatar {
  width: 28px; height: 28px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-avatar-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 600; color: var(--ui-text-on-brand);
  cursor: pointer; flex-shrink: 0; user-select: none;
}

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 闂備浇娉曢崰鎰板几婵犳艾绠瀣昂娴犳盯姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘炬嫹 switch + 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺咃拷?闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠�?.8 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
.demo-mode-switch {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 2px;
  border-radius: var(--ui-radius-pill);
  border: 1px dashed var(--ui-topnav-muted);
  background: transparent;
  white-space: nowrap;
}

.demo-mode-switch__icon {
  width: 24px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-warning);
}

.demo-mode-switch__icon [data-lucide] {
  width: 13px;
  height: 13px;
}

.demo-mode-option {
  min-height: 22px;
  padding: 0 8px;
  border: 0;
  border-radius: var(--ui-radius-pill);
  background: transparent;
  color: var(--ui-topnav-muted);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--ui-duration-fast), color var(--ui-duration-fast);
}

.demo-mode-option:hover,
.demo-mode-option.is-active {
  background: var(--ui-topnav-accent);
  color: var(--ui-topnav-foreground);
}

.demo-banner {
  height: 32px;
  padding: 0 16px;
  display: flex; align-items: center; gap: 8px;
  background: var(--ui-color-warning-subtle);
  color: var(--ui-color-warning);
  font-size: 13px; font-weight: 500;
  border-bottom: 1px solid var(--ui-border-default);
}
.demo-banner [data-lucide] { width: 14px; height: 14px; flex-shrink: 0; }

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 BalanceBox闂備浇娉曢崰鎰板几婵犳艾绠紒瀣殞pNav 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌熷ú璇插箰闁哄拋浜獮蹇旑槹鎼淬垹鏅�? alert levels闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 project-mamba BalanceBox.vue 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
.balance-pill {
  --balance-pill-bg: var(--ui-topnav-surface, rgba(240, 237, 245, 0.06));
  --balance-pill-border: transparent;
  --balance-pill-icon: currentColor;
  --balance-pill-num: var(--ui-topnav-foreground);
  --balance-pill-cta-bg: var(--ui-topnav-surface, rgba(240, 237, 245, 0.08));
  --balance-pill-cta-hover-bg: var(--ui-topnav-hover, rgba(240, 237, 245, 0.16));
  --balance-pill-cta-color: var(--ui-topnav-foreground);
  display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0;
  height: 30px; padding: 0 4px 0 10px; min-width: 0;
  border: 1px solid var(--balance-pill-border);
  border-radius: var(--ui-radius-pill);
  background: var(--balance-pill-bg);
  color: var(--ui-topnav-muted);
  font-size: 12px; font-weight: 500; line-height: 1;
  white-space: nowrap; cursor: pointer;
  transition: background var(--ui-duration-fast), border-color var(--ui-duration-fast), color var(--ui-duration-fast);
}
.balance-pill--readonly { padding-right: 10px; cursor: default; }
.balance-pill__dot {
  width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%;
  background: currentColor;
  animation: balance-pulse-dot 1.4s ease-in-out infinite;
}
@keyframes balance-pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
.balance-pill [data-lucide].balance-pill__icon { width: 14px; height: 14px; flex-shrink: 0; color: var(--balance-pill-icon); }
.balance-pill__num {
  max-width: 96px; overflow: hidden; text-overflow: ellipsis;
  color: var(--balance-pill-num);
  font-family: var(--ui-font-mono);
  font-variant-numeric: tabular-nums;
}
.balance-pill__unit { max-width: 64px; overflow: hidden; text-overflow: ellipsis; opacity: 0.64; }
.balance-pill__cta {
  display: inline-flex; align-items: center; justify-content: center; gap: 4px;
  height: 22px; padding: 0 10px;
  border: 0; border-radius: var(--ui-radius-pill);
  background: var(--balance-pill-cta-bg);
  color: var(--balance-pill-cta-color);
  font-size: 11px; font-weight: 600; line-height: 1;
  white-space: nowrap; cursor: pointer;
  transition: background var(--ui-duration-fast), color var(--ui-duration-fast);
}
.balance-pill__cta:hover { background: var(--balance-pill-cta-hover-bg); }
.balance-pill__cta [data-lucide] { width: 11px; height: 11px; }
/* 4 alert levels: normal / low / critical / empty */
.balance-pill--low {
  --balance-pill-bg: color-mix(in srgb, var(--ui-color-warning) 16%, transparent);
  --balance-pill-border: color-mix(in srgb, var(--ui-color-warning) 42%, transparent);
  --balance-pill-icon: var(--ui-color-warning);
  --balance-pill-num: color-mix(in srgb, var(--ui-color-warning) 52%, var(--ui-topnav-foreground));
  --balance-pill-cta-bg: color-mix(in srgb, var(--ui-color-warning) 86%, var(--ui-topnav-bg));
  --balance-pill-cta-hover-bg: var(--ui-color-warning);
  --balance-pill-cta-color: var(--ui-topnav-bg);
  color: color-mix(in srgb, var(--ui-color-warning) 78%, var(--ui-topnav-foreground));
}
.balance-pill--critical {
  --balance-pill-bg: color-mix(in srgb, var(--ui-color-destructive) 18%, transparent);
  --balance-pill-border: color-mix(in srgb, var(--ui-color-destructive) 48%, transparent);
  --balance-pill-icon: var(--ui-color-destructive);
  --balance-pill-num: var(--ui-color-destructive);
  --balance-pill-cta-bg: var(--ui-color-destructive);
  --balance-pill-cta-hover-bg: color-mix(in srgb, var(--ui-color-destructive) 86%, white);
  --balance-pill-cta-color: white;
  color: var(--ui-color-destructive);
}
.balance-pill--empty {
  --balance-pill-bg: color-mix(in srgb, var(--ui-color-destructive) 24%, transparent);
  --balance-pill-border: var(--ui-color-destructive);
  --balance-pill-icon: var(--ui-color-destructive);
  --balance-pill-num: var(--ui-color-destructive);
  --balance-pill-cta-bg: var(--ui-color-destructive);
  --balance-pill-cta-hover-bg: color-mix(in srgb, var(--ui-color-destructive) 80%, black);
  --balance-pill-cta-color: white;
  color: var(--ui-color-destructive);
}

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 Sidebar 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠�?.3 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
.sidebar {
  width: var(--ui-sidebar-width);
  min-width: var(--ui-sidebar-width);
  background: var(--ui-sidebar-bg);
  border-right: 1px solid var(--ui-sidebar-border);
  padding: 12px 12px 16px;
  display: flex; flex-direction: column; gap: 4px;
  overflow-y: auto; overflow-x: hidden;
}
/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 Scrollbar闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭婢樺鍧楁⒑鐠恒劌鏋欐い銏＄矒閺佹劘绠涢弬娆句紦 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--ui-border-default);
  border-radius: var(--ui-radius-pill);
}
::-webkit-scrollbar-thumb:hover { background: var(--ui-text-muted); }
::-webkit-scrollbar-corner { background: transparent; }

.sidebar-section { margin-bottom: 4px; }

.sidebar-section-title {
  padding: 8px 8px 4px;
  font-size: 12px; font-weight: 500;
  color: var(--ui-sidebar-muted);
  letter-spacing: 0.01em;
}
.sidebar-section + .sidebar-section .sidebar-section-title { padding-top: 12px; }

.nav-item {
  display: flex; align-items: center; gap: 8px;
  padding: 10px;
  border-radius: 6px;
  font-size: 14px; font-weight: 400;
  color: var(--ui-sidebar-foreground);
  transition: background 0.12s, color 0.12s;
  white-space: nowrap;
  width: 100%;
}
.nav-item [data-lucide] { width: 18px; height: 18px; flex-shrink: 0; color: var(--ui-sidebar-muted); }
.nav-item.active { background: var(--ui-sidebar-active-bg); font-weight: 500; color: var(--ui-sidebar-active-fg); }
.nav-item.active [data-lucide] { color: var(--ui-sidebar-active-fg); }
.nav-item:not(.active):hover { background: var(--ui-accent); }

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 Stage闂備浇娉曢崰鎰板几婵犳艾绠紒灞鹃ゥell-only 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺瀹曪絾瀵肩€涙ɑ娅㈤梺鍝勫€堕崐鏍偓姘炬嫹 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 */
.stage-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
}
.stage-card {
  max-width: 480px; width: 100%;
  text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 16px;
}
.stage-chip {
  display: inline-flex; align-items: center; gap: 6px;
  height: 28px; padding: 0 12px;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-color-primary-subtle);
  color: var(--ui-color-primary);
  font-size: 12px; font-weight: 600;
}
.stage-title {
  font-family: var(--ui-font-heading);
  font-size: 26px; font-weight: 800;
  color: var(--ui-text-primary); line-height: 1.2;
}
.stage-desc {
  font-size: 14px; line-height: 1.7;
  color: var(--ui-text-muted);
}
.stage-badges {
  display: flex; flex-wrap: wrap; gap: 8px;
  justify-content: center; margin-top: 4px;
}
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  height: 22px; padding: 3px 10px;
  border-radius: var(--ui-radius-pill);
  font-size: 11px; font-weight: 500; letter-spacing: 0.2px;
}
.badge-green  { background: var(--ui-badge-green-bg);  color: var(--ui-badge-green-fg); }
.badge-blue   { background: var(--ui-badge-blue-bg);   color: var(--ui-badge-blue-fg); }
.badge-purple { background: var(--ui-badge-purple-bg); color: var(--ui-badge-purple-fg); }
.badge-orange { background: var(--ui-badge-orange-bg); color: var(--ui-badge-orange-fg); }
.badge-yellow { background: var(--ui-badge-yellow-bg); color: var(--ui-badge-yellow-fg); }
.badge-muted  { background: var(--ui-badge-muted-bg);  color: var(--ui-badge-muted-fg); }
.badge-red    { background: var(--ui-color-destructive-subtle); color: var(--ui-color-destructive); }

/* 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋戦柡瀣煼楠炲繘鎮滈懞銉︽闂佸搫鍊堕崐鏍偓姘炬嫹
