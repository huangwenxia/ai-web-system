const PrototypeComponents = {

  // <HeaderBox title subtitle> + slot:actions + default slot闂備浇娉曢崰鎰板几婵犳艾绠紒灞界┘lter/extra 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌熼悷鏉挎缂傚秴娲獮锟�?
  HeaderBox: {
    props: {
      title:    { type: String, required: true },
      subtitle: { type: String, default: '' },
    },
    template: `
      <div class="header-box" data-component="header-box">
        <div class="header-box__top">
          <div style="min-width:0;">
            <h1 class="header-box__title">{{ title }}</h1>
            <p v-if="subtitle" class="header-box__subtitle">{{ subtitle }}</p>
          </div>
          <div v-if="$slots.actions" class="header-box__right">
            <slot name="actions"></slot>
          </div>
        </div>
        <div v-if="$slots.default" class="header-box__content">
          <slot></slot>
        </div>
      </div>
    `
  },

  // <KpiCard title value icon iconColor trend trendType>
  KpiCard: {
    props: {
      title:     { type: String, required: true },
      value:     { type: [String, Number], default: '' },
      icon:      { type: String, default: '' },
      iconColor: { type: String, default: 'primary' }, // primary|success|warning|destructive
      trend:     { type: String, default: '' },
      trendType: { type: String, default: 'neutral' }, // up|down|neutral
    },
    template: `
      <div class="kpi-card" data-component="kpi-card">
        <div class="kpi-card__header">
          <span class="kpi-card__title">{{ title }}</span>
          <i v-if="icon" :data-lucide="icon" class="kpi-card__icon" :class="'kpi-card__icon--' + iconColor"></i>
        </div>
        <div class="kpi-card__value"><slot>{{ value }}</slot></div>
        <div v-if="trend || $slots.trend" class="kpi-card__trend" :class="'kpi-card__trend--' + trendType">
          <slot name="trend">{{ trend }}</slot>
        </div>
      </div>
    `
  },

  // <StatusBadge status [label]> 闂備浇娉曢崰鎰板几婵犳艾绠�?status: active|pending|expiringSoon|inactive|revoked|expired|error
  StatusBadge: {
    props: {
      status: { type: String, required: true },
      label:  { type: String, default: '' },
    },
    computed: {
      badgeClass() {
        return {
          active:        'badge-green',
          pending:       'badge-orange',
          expiringSoon:  'badge-orange',
          inactive:      'badge-muted',
          revoked:       'badge-red',
          expired:       'badge-muted',
          error:         'badge-red',
        }[this.status] || 'badge-muted';
      }
    },
    template: `
      <span class="status-badge" :class="badgeClass" data-component="status-badge">
        <span class="status-badge__dot"></span>
        <span><slot>{{ label || status }}</slot></span>
      </span>
    `
  },

  // <EmptyState icon title hint> + slot:action
  EmptyState: {
    props: {
      icon:  { type: String, default: 'inbox' },
      title: { type: String, required: true },
      hint:  { type: String, default: '' },
    },
    template: `
      <div class="empty-state" data-component="empty-state">
        <i :data-lucide="icon" class="empty-state__icon"></i>
        <p class="empty-state__title">{{ title }}</p>
        <p v-if="hint" class="empty-state__hint">{{ hint }}</p>
        <div v-if="$slots.action"><slot name="action"></slot></div>
      </div>
    `
  },

  // <Alert variant title desc closable> 闂備浇娉曢崰鎰板几婵犳艾绠�?variant: success|warning|error|info
  Alert: {
    props: {
      variant:  { type: String, default: 'info' },
      title:    { type: String, required: true },
      desc:     { type: String, default: '' },
      closable: { type: Boolean, default: false },
    },
    data() { return { visible: true }; },
    computed: {
      iconName() {
        return {
          success: 'circle-check',
          warning: 'triangle-alert',
          error:   'circle-x',
          info:    'info',
        }[this.variant] || 'info';
      }
    },
    template: `
      <div v-if="visible" class="alert" :class="'alert-' + variant" data-component="alert">
        <i :data-lucide="iconName" class="alert-icon"></i>
        <div class="alert-body">
          <p class="alert-title">{{ title }}</p>
          <p v-if="desc || $slots.default" class="alert-desc"><slot>{{ desc }}</slot></p>
        </div>
        <button v-if="closable" class="alert-close" type="button" @click="visible = false" aria-label="Close">
          <i data-lucide="x"></i>
        </button>
      </div>
    `
  },

  // <UsageBar used total unit color showText> 闂備浇娉曢崰鎰板几婵犳艾绠�?color: auto|primary|success|warning|danger
  // v3.5
  UsageBar: {
    props: {
      used:     { type: Number, required: true },
      total:    { type: Number, required: true },
      unit:     { type: String, default: '' },
      color:    { type: String, default: 'auto' },
      showText: { type: Boolean, default: true },
    },
    computed: {
      percent() {
        if (!this.total) return 0;
        return Math.min(100, (this.used / this.total) * 100);
      },
      autoColor() {
        if (this.color !== 'auto') return this.color;
        if (this.percent >= 100) return 'danger';
        if (this.percent >= 80)  return 'warning';
        return 'primary';
      },
    },
    template: `
      <div class="usage-bar" data-component="usage-bar">
        <div class="usage-bar__track">
          <div class="usage-bar__fill" :class="'usage-bar__fill--' + autoColor" :style="{ width: percent + '%' }"></div>
        </div>
        <span v-if="showText" class="usage-bar__text">
          <slot>{{ used }}{{ unit }} / {{ total }}{{ unit }}</slot>
        </span>
      </div>
    `
  },

  // <KvCard title :items hover labelWidth> + slot:headerRight + slot:[item.key] for custom value
  // items: [{ label: '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹', value: '...', key: 'name' }]
  // v3.5
  KvCard: {
    props: {
      title:      { type: String, default: '' },
      items:      { type: Array, default: () => [] },
      labelWidth: { type: String, default: 'auto' },
      hover:      { type: Boolean, default: false },
    },
    template: `
      <div class="kv-card" :class="{ 'kv-card--hover': hover }" data-component="kv-card">
        <div v-if="title || $slots.headerRight" class="kv-card__head">
          <div class="kv-card__title">{{ title }}</div>
          <div v-if="$slots.headerRight" class="kv-card__head-right">
            <slot name="headerRight"></slot>
          </div>
        </div>
        <div class="kv-card__body">
          <div v-for="(it, i) in items" :key="it.key || i" class="kv-card__row">
            <div class="kv-card__label" :style="labelWidth !== 'auto' ? { width: labelWidth } : {}">{{ it.label }}闂備浇娉曢崰鎰板几婵犳艾绠�?/div>
            <div class="kv-card__value">
              <slot :name="it.key || ('item' + i)" :item="it">{{ it.value }}</slot>
            </div>
          </div>
          <slot></slot>
        </div>
      </div>
    `
  },

  // <DetailSection title> + slot:headerRight + default
  // 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺咃拷?4px 闂備浇娉曢崰鎰板几婵犳艾绠柣銈庡灠椤ュ繘姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘炬嫹 + 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鎮峰▎娆戠Ф缂佽鲸绻堥弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮幘璇叉闁靛牆妫楅璺侯渻閿燂拷?section 闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭婢樺▍锟�
  // v3.5
  DetailSection: {
    props: {
      title: { type: String, required: true },
    },
    template: `
      <div class="detail-section" data-component="detail-section">
        <div class="detail-section__head">
          <span class="detail-section__title">{{ title }}</span>
          <div v-if="$slots.headerRight" class="detail-section__right">
            <slot name="headerRight"></slot>
          </div>
        </div>
        <div class="detail-section__body">
          <slot></slot>
        </div>
      </div>
    `
  },

  // <TableActions :actions max>
  // actions: [{ label, type?, icon?, disabled?, danger?, onClick }]
  // 闂備浇娉曢崰鎰板几婵犳艾绠紒灞炬簜x 闂備浇娉曢崰鎰板几婵犳艾绠瀣昂娴犳稑鈽夐敓锟�?link button闂備浇娉曢崰鎰板几婵犳艾绠�?max 闂備浇娉曢崰鎾斥枔閺囩姵濯奸悷娆忓椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈢紓鍌氬€搁顓€€傞鈧獮锟�?... 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 dropdown
  // v3.5
  TableActions: {
    props: {
      actions: { type: Array, required: true },
      max:     { type: Number, default: 3 },
    },
    computed: {
      visibleActions()  { return this.actions.slice(0, this.max); },
      overflowActions() { return this.actions.slice(this.max); },
    },
    methods: {
      handle(a, e) { if (a.onClick) a.onClick(e); },
    },
    template: `
      <div class="table-actions" data-component="table-actions">
        <el-button
          v-for="(a, i) in visibleActions" :key="'v' + i"
          link
          :type="a.danger ? 'danger' : (a.type || 'primary')"
          :disabled="a.disabled"
          @click="handle(a, $event)"
        >
          <i v-if="a.icon" :data-lucide="a.icon" style="width:14px;height:14px;margin-right:4px;"></i>
          {{ a.label }}
        </el-button>
        <el-dropdown v-if="overflowActions.length" trigger="click">
          <el-button link type="primary">
            <i data-lucide="ellipsis" style="width:16px;height:16px;"></i>
          </el-button>
          <template #dropdown>
            <el-dropdown-menu>
              <el-dropdown-item
                v-for="(a, i) in overflowActions" :key="'o' + i"
                :disabled="a.disabled"
                :class="{ 'is-danger': a.danger }"
                @click="handle(a, $event)"
              >
                <i v-if="a.icon" :data-lucide="a.icon" style="width:14px;height:14px;margin-right:6px;"></i>
                {{ a.label }}
              </el-dropdown-item>
            </el-dropdown-menu>
          </template>
        </el-dropdown>
      </div>
    `
  },

