      pageSize:        { type: Number,  default: 10 },
      loading:         { type: Boolean, default: false },
      emptyText:       { type: String,  default: '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅锟� / No data' },
      showPagination:  { type: Boolean, default: true },
      operationsLabel: { type: String,  default: '闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹' },
      operationsWidth: { type: [String, Number], default: 160 },
    },
    emits: ['update:page', 'update:pageSize', 'row-click'],
    template: `
      <div class="data-table" data-component="data-table">
        <el-table
          v-loading="loading"
          :data="data"
          :empty-text="emptyText"
          style="width:100%;"
          @row-click="(row) => $emit('row-click', row)"
        >
          <el-table-column
            v-for="col in columns"
            :key="col.key || col.prop || col.label"
            :prop="col.prop"
            :label="col.label"
            :width="col.width"
            :min-width="col.minWidth"
            :fixed="col.fixed"
            :align="col.align || 'left'"
            :sortable="col.sortable"
          >
            <template #default="scope" v-if="col.slot">
              <slot :name="col.slot" :row="scope.row" :col="col" :index="scope.$index"></slot>
            </template>
          </el-table-column>
          <el-table-column
            v-if="$slots.operations"
            :label="operationsLabel"
            :width="operationsWidth"
            fixed="right"
          >
            <template #default="scope">
              <slot name="operations" :row="scope.row" :index="scope.$index"></slot>
            </template>
          </el-table-column>
        </el-table>
        <div v-if="showPagination && total > 0" class="data-table__pagination">
          <el-pagination
            :current-page="page"
            :page-size="pageSize"
            :total="total"
            layout="total, prev, pager, next"
            :pager-count="5"
            background
            @current-change="(p) => $emit('update:page', p)"
            @size-change="(s) => $emit('update:pageSize', s)"
          ></el-pagination>
        </div>
      </div>
    `
  },

  // <Tag color preset icon> + slot:default 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備緡鍋呭畝鎼佸极閹剧粯鍎楁い鎰剁到閺侀箖鏌熼悜绛嬫妞ゆ帞鍏橀弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮幘璇叉闁靛牆妫楅鍫曟煟濡灝鐓愰柍褜鍏涚欢姘跺极閹捐妫橀柕鍫濇椤忥拷
  // color: purple|blue|green|orange|yellow|muted|red
  // preset: trending|new|beta|stable|deprecated闂備浇娉曢崰鎰板几婵犳艾绠紒瀣亼g 闂備浇娉曢崰鎾跺垝閸涘﹤顕辨繛鍡樺姇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮锟�?
  //       | conversation|multi-modal|reasoning|embedding|image闂備浇娉曢崰鎰板几婵犳艾绠梺鍨憯娓氣偓閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅鍫曟⒑鐠恒劌鏋涢柛娆愭そ閺佹劘绠涢弬娆句紦
  // v3.6
  Tag: {
    props: {
      color:  { type: String, default: 'muted' },
      preset: { type: String, default: '' },
      icon:   { type: String, default: '' },
    },
    computed: {
      finalColor() {
        const map = {
          // Tag 闂備浇娉曢崰鎾跺垝閸涘﹤顕辨繛鍡樺姇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘炬嫹2.3闂備浇娉曢崰鎰板几婵犳艾绠�?
          trending: 'purple', new: 'green', beta: 'blue', stable: 'muted', deprecated: 'muted',
          // 濠碘槅鍨界换婵嬪极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘炬嫹 Badge闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹2.3闂備浇娉曢崰鎰板几婵犳艾绠�?
          conversation: 'blue', 'multi-modal': 'purple', reasoning: 'orange', embedding: 'yellow', image: 'green',
        };
        return this.preset ? (map[this.preset.toLowerCase()] || this.color) : this.color;
      },
      finalIcon() {
        if (this.preset === 'deprecated') return 'triangle-alert';
        return this.icon;
      },
      finalLabel() {
        const labelMap = { 'multi-modal': 'Multi-Modal' };
        if (labelMap[this.preset]) return labelMap[this.preset];
        if (!this.preset) return '';
        return this.preset.charAt(0).toUpperCase() + this.preset.slice(1);
      }
    },
    template: `
      <span class="tag" :class="'badge-' + finalColor" data-component="tag">
        <i v-if="finalIcon" :data-lucide="finalIcon"></i>
        <slot>{{ finalLabel }}</slot>
      </span>
    `
  },

  // <CardBox title> + slot:headerRight + default 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備緡鍋呭畝鎼佸极閹剧粯鍎楁い鎰╁灩閻繝鏌熼悜绛嬫濠⒀勭墵閺屻劑鎮㈤崨濠勪紕闂佸綊顥撻崗姗€寮幘璇叉闁靛牆妫楅锟�
  // v3.6
  CardBox: {
    props: {
      title:  { type: String, default: '' },
      padded: { type: Boolean, default: false },
    },
    template: `
      <div class="card-box" :class="{ 'card-box--padded': padded }" data-component="card-box">
        <div v-if="title || $slots.headerRight" class="card-box__head">
          <div class="card-box__title">{{ title }}</div>
          <div v-if="$slots.headerRight" class="card-box__head-right">
            <slot name="headerRight"></slot>
