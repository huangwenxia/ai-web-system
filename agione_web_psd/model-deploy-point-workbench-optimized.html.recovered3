  color: var(--ui-text-secondary);
  background: var(--ui-bg-muted);
}

.source-no-extra__icon {
  width: calc(var(--ui-space-lg) * 1.35);
  height: calc(var(--ui-space-lg) * 1.35);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-success);
  background: color-mix(in srgb, var(--ui-color-success) 10%, var(--ui-bg-card));
}

.dialog-section {
