  background: var(--ui-bg-muted);
}

.location-picker__list {
  display: flex;
  flex-direction: column;
  gap: var(--ui-space-sm);
  padding: var(--ui-space-sm);
}

.location-option {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  min-height: 68px;
  padding: 10px 12px;
  border: 1px solid var(--ui-border-soft);
  border-radius: var(--ui-radius-lg);
  background: color-mix(in srgb, var(--ui-bg-card) 92%, var(--ui-bg-muted));
  cursor: pointer;
  transition: border-color var(--ui-duration-fast) var(--ui-ease-out),
              background var(--ui-duration-fast) var(--ui-ease-out),
              box-shadow var(--ui-duration-fast) var(--ui-ease-out);
}

.location-option:hover {
  border-color: color-mix(in srgb, var(--ui-color-primary) 28%, var(--ui-border-soft));
  background: color-mix(in srgb, var(--ui-color-primary) 5%, var(--ui-bg-card));
}

.location-option.is-selected {
  border-color: var(--ui-color-primary);
  background: color-mix(in srgb, var(--ui-color-primary) 7%, var(--ui-bg-card));
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--ui-color-primary) 10%, transparent);
}

.location-option.is-added {
  color: var(--ui-text-muted);
  background: color-mix(in srgb, var(--ui-bg-card) 88%, var(--ui-bg-muted));
}

.location-option.is-selected .scope-brand-mark,
.location-option.is-added .scope-brand-mark {
  border-color: color-mix(in srgb, var(--ui-color-primary) 28%, var(--ui-border-soft));
  background: var(--ui-bg-card);
}

.location-option__meta {
  display: flex;
  align-items: center;
  gap: var(--ui-space-sm);
  justify-self: end;
}

.dialog-form-item-wide {
  grid-column: 1 / -1;
}

.readonly-source-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-space-md);
