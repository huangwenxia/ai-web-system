}

@media (max-width: 78rem) {
  .canvas-board,
  .canvas-hero,
  .canvas-stepper,
  .detail-record-body,
  .dialog-form-grid.is-three,
  .config-filter-grid,
  .api-dialog-grid,
  .api-param-preview-table .canvas-table-row,
  .api-param-editor__row {
    grid-template-columns: 1fr;
  }

  .source-option-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .canvas-step:not(:last-child)::after {
    display: none;
  }

  .canvas-bottom-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .canvas-panel {
    min-height: auto;
  }

  .canvas-scope-scroll {
    flex: none;
