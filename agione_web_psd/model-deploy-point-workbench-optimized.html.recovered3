  .canvas-stage-rail,
  .inspector-form-grid,
  .inspector-radio-row,
  .dialog-form-grid,
  .location-option {
    grid-template-columns: 1fr;
  }

  .source-option-grid {
    grid-template-columns: 1fr;
  }

  .location-picker__head {
    flex-direction: column;
    align-items: stretch;
  }

  .location-picker__filters {
    justify-content: flex-start;
  }

  .location-filter-select {
    width: 100%;
  }

  .location-option__meta {
    justify-items: start;
    justify-self: start;
  }

}
