  // <Tabs :options v-model variant> 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 Tabs闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?DetailPage闂備浇娉曢崰鎰板几婵犳艾绠�?
  // variant: underline (婵帗绋掗敃銏ゅ极閹捐妫橀柕鍫濇椤忥拷) | segmented
  // options: [{ label, value, count? }]
  // v3.6
  Tabs: {
    props: {
      options:    { type: Array, required: true },
      modelValue: { type: [String, Number], default: '' },
      variant:    { type: String, default: 'underline' },
    },
    emits: ['update:modelValue'],
    template: `
      <div v-if="variant === 'segmented'" class="tabs-segmented" data-component="tabs">
        <button
          v-for="opt in options" :key="opt.value"
          type="button"
          class="tabs-segmented__item"
          :class="{ 'is-active': modelValue === opt.value }"
          @click="$emit('update:modelValue', opt.value)"
        >
          {{ opt.label }}
          <span v-if="opt.count != null" class="tabs-segmented__count">{{ opt.count }}</span>
        </button>
      </div>
      <div v-else class="detail-tabs" data-component="tabs">
        <button
          v-for="opt in options" :key="opt.value"
          type="button"
          class="detail-tabs__item"
          :class="{ 'is-active': modelValue === opt.value }"
          @click="$emit('update:modelValue', opt.value)"
        >
          {{ opt.label }}
          <span v-if="opt.count != null" style="margin-left:6px;color:var(--ui-text-muted);font-weight:400;">({{ opt.count }})</span>
        </button>
      </div>
    `
  },

  // <Avatar src name size color> 闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎾绘偂椤愶絽顕辨繛鍡樺姇椤忚泛顭块懜鍨唉闁轰焦鎹囧顒勫Χ閸℃浼搇etter fallback + 闂備浇娉曢崰鎾斥枔閺囩姵濯奸悷娆忓椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙偪椤栨凹妫岄梻浣芥硶閸犳劙寮告繝姘?
  // size: small|default|large
  // v3.6
  Avatar: {
    props: {
      src:   { type: String, default: '' },
      name:  { type: String, default: '' },
      size:  { type: String, default: 'default' },
      color: { type: String, default: '' }, // 闂備浇娉曢崰鎾斥枔閺囩姵濯奸悷娆忓椤忓爼姊虹捄銊ユ灆婵☆偄瀚伴幊妤€鐣濋崟顒佹闂佸搫鍊堕崐鏍偓姘秺閹筹拷?
    },
    computed: {
      initials() {
        if (!this.name) return '?';
        const parts = this.name.trim().split(/\s+/);
        if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        return this.name.substring(0, 2).toUpperCase();
      },
      sizeClass() { return 'avatar-' + this.size; },
      autoBg() {
        if (this.color) return this.color;
        if (!this.name) return 'var(--ui-bg-muted)';
        const palette = [
          'var(--ui-badge-purple-bg)',
          'var(--ui-badge-blue-bg)',
          'var(--ui-badge-green-bg)',
          'var(--ui-badge-orange-bg)',
          'var(--ui-badge-yellow-bg)',
        ];
        const hash = [...this.name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
        return palette[hash % palette.length];
      },
      autoFg() {
        if (this.color) return 'var(--ui-text-on-brand)';
        if (!this.name) return 'var(--ui-text-muted)';
        const palette = [
          'var(--ui-badge-purple-fg)',
          'var(--ui-badge-blue-fg)',
          'var(--ui-badge-green-fg)',
          'var(--ui-badge-orange-fg)',
          'var(--ui-badge-yellow-fg)',
        ];
        const hash = [...this.name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
        return palette[hash % palette.length];
      },
    },
    template: `
      <div class="avatar" :class="sizeClass" data-component="avatar"
           :style="{ background: autoBg, color: autoFg }">
        <img v-if="src" :src="src" :alt="name" />
        <span v-else>{{ initials }}</span>
      </div>
    `
  },

  // <BalanceBox :info :lang> 闂備浇娉曢崰鎰板几婵犳艾绠�?TopNav 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌熷ú璇插箰闁哄拋浜獮蹇旑槹鎼淬垹鏅冲銈庡幗鐢鈧艾缍婇弻銊╂偄閸涘﹦浼勯梺褰掝棑閸忔﹢寮敓锟�?project-mamba BalanceBox.vue闂備浇娉曢崰鎰板几婵犳艾绠�?
  // info: { balance: Number, level: 'normal'|'low'|'critical'|'empty', currency: 'Credits', showTopUp: Boolean, topUpLabel?: String, runwayDays?: Number }
  // 4 alert levels 闂備浇娉曢崰鎾斥枔閺囩姵濯奸悷娆忓椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇涙偪椤栨凹妫岄梻浣芥硶閸犳劙寮告繝姘缂佸本妲祐el=normal 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘贡缁牆煤椤忓懏娅㈤梺鍝勫€堕崐鏍偓姘秺閺岋拷?dot闂備浇娉曢崰鎰板几婵犳艾绠紒灞界嵃itical/empty 闂備浇娉曢崰鎰板几婵犳艾绠瀣昂娴犳盯姊虹捄銊ユ瀾闁哄顭烽獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘炬嫹 dot
  // currency 闂備浇娉曢崰鏇€€佸⿰鍛閻熸瑥瀚锟�**闂佺儵鏅滈幐鎶藉极閹捐妫橀柕鍫濇椤忓爼姊虹捄銊ユ瀾闁哄顭烽獮蹇旑槹鎼存稐绮�**闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤悜妯兼殾闁荤姳娴囬～澶屸偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?s闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺櫢鎷�?'Credits' / 'CREDIT' / '闂備浇娉曢崰鎰板几婵犳艾绠�? / 'Tokens'
  // topUpLabel 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺瀵噣宕奸弴鐔告闂佸搫鍊堕崐鏍偓姘炬嫹 lang prop 闂備浇娉曢崰鎾斥枔閺囩姵濯奸悷娆忓椤忥拷 zh闂備浇娉曢崰鎰板几婵犳艾绠�?闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭澹嬮崑锟�? / en闂備浇娉曢崰鎰板几婵犳艾绠�?Top Up"
  // v4.6 / v4.7 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘秺閺屻劑鎮㈤崨濠勪紕闂佺懓鍢查崲鎻捗瑰鈧弻銊╂偄閸涘﹦浼勯梺鐧告嫹?normal闂備浇娉曢崰鎰板几婵犳艾绠紒灞界暜tabase闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌ｅ▎娆戠？妞ゆ帗鐓￠獮蹇涙倻閼恒儲娅㈤梺姹囧妼濡粓顢欓幇鏉跨闁绘垼濮ら弲鎼佹煛閸屾ê鈧牜鈧熬鎷� s闂備浇娉曢崰鎰板几婵犳艾绠紒瀣垫暯A 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹 lang
  BalanceBox: {
    props: {
      info: { type: Object, required: true },
      lang: { type: String, default: 'en' },
    },
    computed: {
      level() {
        const lv = (this.info?.level || 'normal').toLowerCase();
        return ['normal', 'low', 'critical', 'empty'].includes(lv) ? lv : 'normal';
      },
      iconName() {
        return {
          normal:   'database',         // 闂侀潻绠戝Λ娑㈡偤閿燂拷 + 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鎮峰▎鎰嚋缂傚秴娲獮蹇涙倻閼恒儲娅㈤梺鍝勫€堕崐鏍偓姘秺瀹曨亣绠涘☉娆愭?EP Coin
          low:      'wallet',
          critical: 'triangle-alert',
          empty:    'circle-x',
        }[this.level];
      },
      showDot() { return this.level === 'critical' || this.level === 'empty'; },
      showTopUp() { return this.info?.showTopUp !== false; },
      currency() { return this.info?.currency || 'Credits'; },
      topUpText() {
        if (this.info?.topUpLabel) return this.info.topUpLabel;
        return this.lang === 'zh' ? '闂備浇娉曢崰鎰板几婵犳艾绠€瑰嫭澹嬮崑锟�? : 'Top Up';
      },
      formattedBalance() {
        const n = Number(this.info?.balance);
        if (!Number.isFinite(n)) return '--';
        return n.toLocaleString('en-US', { maximumFractionDigits: Number.isInteger(n) ? 0 : 2 });
      },
    },
    template: `
      <div class="balance-pill" data-component="balance-pill"
           :class="['balance-pill--' + level, { 'balance-pill--readonly': !showTopUp }]"
           role="status">
        <span v-if="showDot" class="balance-pill__dot" aria-hidden="true"></span>
        <i :data-lucide="iconName" class="balance-pill__icon"></i>
        <span class="balance-pill__num">{{ formattedBalance }}</span>
        <span class="balance-pill__unit">{{ currency }}</span>
        <button v-if="showTopUp" class="balance-pill__cta" type="button" @click.stop>
          <i data-lucide="plus"></i>
          <span>{{ topUpText }}</span>
        </button>
      </div>
    `
  },

  // <DetailPage title subtitle :tabs activeTab showBack> + slot:actions + default
  // 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘愁潐閵囧嫰鎮介崨濠冩闂佸搫鍊堕崐鏍偓姘辨嚀閻ｏ繝鏁嶉崟顐闂備浇娉曢崰鎾剁矈閻滄笅nBox + HeaderBox(闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹+闂備浇娉曢崰鎰板几婵犳艾绠柣鎴ｅГ閺呮悂鏌￠崒妯衡偓鏍偓姘炬嫹+actions) + 闂備浇娉曢崰鎰板几婵犳艾绠柣鎴Ｐ掗崑锟�?Tabs + ScrollBox
  // v3.5
  DetailPage: {
    props: {
      title:     { type: String, required: true },
      subtitle:  { type: String, default: '' },
      tabs:      { type: Array, default: () => [] },
      activeTab: { type: [String, Number], default: '' },
      showBack:  { type: Boolean, default: true },
    },
    emits: ['update:activeTab', 'back'],
    template: `
      <div class="main-box" data-component="main-box">
        <div class="header-box" data-component="header-box">
          <div class="header-box__top">
            <div style="display:flex;align-items:center;gap:8px;min-width:0;">
              <button v-if="showBack" class="btn-back" type="button" @click="$emit('back')" aria-label="Back">
                <i data-lucide="arrow-left"></i>
              </button>
              <div style="min-width:0;">
                <h1 class="header-box__title">{{ title }}</h1>
                <p v-if="subtitle" class="header-box__subtitle">{{ subtitle }}</p>
              </div>
            </div>
            <div v-if="$slots.actions" class="header-box__right">
              <slot name="actions"></slot>
            </div>
          </div>
          <div v-if="tabs.length" class="header-box__content" style="padding-top:0;border-top:none;">
            <div class="detail-tabs" data-component="detail-tabs">
              <button
                v-for="tab in tabs" :key="tab.value"
                class="detail-tabs__item"
                :class="{ 'is-active': activeTab === tab.value }"
                type="button"
                @click="$emit('update:activeTab', tab.value)"
              >{{ tab.label }}</button>
            </div>
          </div>
        </div>
        <el-scrollbar>
          <div class="scroll-box-inner" data-scroll-box data-component="scroll-box">
            <slot></slot>
          </div>
        </el-scrollbar>
      </div>
    `
  },

