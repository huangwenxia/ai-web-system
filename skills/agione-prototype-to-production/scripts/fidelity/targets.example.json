[
  {
    "name": "page-overview",
    "viewport": { "width": 1440, "height": 900 },
    "fullPage": true,
    "settleMs": 1800,
    "proto": {
      "url": "http://localhost:8088/prototype.html",
      "waitFor": ".prototype-overview"
    },
    "impl": {
      "url": "http://localhost:8030/app/overview",
      "waitFor": ".production-overview",
      "waitForGone": ".production-overview .el-loading-mask",
      "requiresAuth": true,
      "storageState": "auth.json"
    },
    "states": [
      {
        "name": "en-light",
        "impl": {
          "state": {
            "localStorage": {
              "__REPLACE_LOCALE_STORAGE_KEY__": "en",
              "__REPLACE_THEME_STORAGE_KEY__": "light"
            },
            "removeHtmlClasses": ["dark"]
          }
        }
      },
      {
        "name": "zh-dark",
        "proto": {
          "setup": [
            { "type": "click", "selector": "button[title='Language']" },
            { "type": "click", "selector": "button[title='Toggle theme']" }
          ]
        },
        "impl": {
          "state": {
            "localStorage": {
              "__REPLACE_LOCALE_STORAGE_KEY__": "zh-cn",
              "__REPLACE_THEME_STORAGE_KEY__": "dark"
            },
            "htmlClasses": ["dark"]
          }
        }
      }
    ],
    "mask": [".dynamic-amount", ".chart-canvas", ".table-body"],
    "probe": {
      "pageShell": {
        "proto": ".prototype-overview",
        "impl": ".production-overview",
        "fields": ["fontFamily", "fontSize", "color", "backgroundColor", "padding", "left", "top", "width", "height"]
      },
      "pageTitle": {
        "proto": ".prototype-overview .page-title",
        "impl": ".production-overview .page-title",
        "fields": ["fontFamily", "fontSize", "fontWeight", "lineHeight", "letterSpacing", "color", "margin", "left", "top", "width", "height"]
      },
      "metricCards": {
        "proto": ".prototype-overview .metric-card",
        "impl": ".production-overview .metric-card",
        "all": true,
        "fields": ["backgroundColor", "backgroundImage", "backgroundSize", "backgroundPosition", "boxShadow", "borderTop", "borderRadius", "padding", "left", "top", "width", "height"]
      },
      "metricIcons": {
        "proto": ".prototype-overview .metric-card svg",
        "impl": ".production-overview .metric-card svg",
        "all": true,
        "fields": ["left", "top", "width", "height", "svgViewBox", "svgSignature", "stroke", "strokeWidth", "fill"]
      },
      "tableHeader": {
        "proto": ".prototype-overview thead th",
        "impl": ".production-overview thead th",
        "all": true,
        "compareText": true,
        "fields": ["text", "fontFamily", "fontSize", "fontWeight", "lineHeight", "color", "padding", "borderBottom", "left", "top", "width", "height"]
      }
    },
    "gate": {
      "failOnConsoleError": true
    }
  }
]
